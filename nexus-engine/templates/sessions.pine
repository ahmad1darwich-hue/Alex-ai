//@version=6
indicator("Nexus Sessions & Kill Zones", shorttitle = "NX Sess", overlay = true, max_boxes_count = 200, max_lines_count = 300, max_labels_count = 300)

// ---------- Inputs ----------
string GRP_K = "Kill zones (times in the timezone below)"
string tzInput      = input.string("America/New_York", "Timezone", options = ["America/New_York", "Europe/London", "Asia/Tokyo", "Australia/Sydney", "Asia/Dubai", "UTC"], group = GRP_K, tooltip = "IANA timezone: follows daylight saving automatically. Default hours are the usual New York kill zones.")
bool   showAsiaInput = input.bool(true, "Asia", group = GRP_K, inline = "a")
string asiaInput    = input.session("2000-0000", "", group = GRP_K, inline = "a")
bool   showLonInput = input.bool(true, "London", group = GRP_K, inline = "l")
string lonInput     = input.session("0200-0500", "", group = GRP_K, inline = "l")
bool   showNyInput  = input.bool(true, "New York AM", group = GRP_K, inline = "n")
string nyInput      = input.session("0700-1000", "", group = GRP_K, inline = "n")
bool   showPmInput  = input.bool(false, "New York PM", group = GRP_K, inline = "p")
string pmInput      = input.session("1330-1600", "", group = GRP_K, inline = "p")
int    maxTfInput   = input.int(60, "Show on charts up to (minutes)", minval = 1, group = GRP_K, tooltip = "Kill zones are an intraday tool: they are hidden on higher timeframes.")
bool   midInput     = input.bool(true, "Session midline (50%)", group = GRP_K)

string GRP_L = "Liquidity"
bool showLiqInput = input.bool(true, "Session high / low until taken", group = GRP_L, tooltip = "Each finished session leaves its high and low as liquidity lines. A line ends when price trades through it; a wick through with a close back inside is marked as a sweep.")
int  maxLiqInput  = input.int(8, "Keep newest levels", minval = 2, maxval = 40, group = GRP_L)
bool showPdInput  = input.bool(true, "Previous day high / low", group = GRP_L)
bool showPwInput  = input.bool(false, "Previous week high / low", group = GRP_L)

string GRP_D = "Dashboard"
bool   showDashInput = input.bool(true, "Show dashboard", group = GRP_D)
string dashPosInput  = input.string("Top right", "Position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = GRP_D)
int    adrLenInput   = input.int(20, "ADR length (days)", minval = 1, group = GRP_D, tooltip = "Average daily range. 'Range used' compares today's range with it: low values leave room to run, above 100% the day is stretched.")

string GRP_ST = "Style"
string themeInput = input.string("Neon", "Theme", options = ["Neon", "Classic", "Minimal", "Mono"], group = GRP_ST)

// ---------- Theme ----------
pick(color neon, color classic, color minimal, color mono) =>
    themeInput == "Neon" ? neon : themeInput == "Classic" ? classic : themeInput == "Minimal" ? minimal : mono

color bullC   = pick(#00E5A0, #089981, #26A69A, #D1D4DC)
color bearC   = pick(#FF3D71, #F23645, #EF5350, #787B86)
color accentC = pick(#7C4DFF, #2962FF, #B2B5BE, #E0E3EB)
color textC   = pick(#9598A1, #787B86, #9598A1, #B2B5BE)
color asiaC   = pick(#7C4DFF, #9C27B0, #9598A1, #B2B5BE)
color lonC    = pick(#00B8D9, #2962FF, #787B86, #9598A1)
color nyC     = pick(#00E5A0, #089981, #26A69A, #D1D4DC)
color pmC     = pick(#FFB300, #FF9800, #B2B5BE, #787B86)

// ---------- State ----------
type Level
    float price
    int   dir
    line  ln
    label lb

var array<Level> levels = array.new<Level>()

bool tfOk = timeframe.isintraday and timeframe.in_seconds() <= maxTfInput * 60

// One box per session: created on its first bar, stretched while it runs. Returns the session's state.
killZone(string sess, bool show, color c, string name) =>
    var box   bx = na
    var line  mid = na
    var float hi = na
    var float lo = na
    var int   hiBar = na
    var int   loBar = na
    bool inSess  = show and tfOk and not na(time(timeframe.period, sess, tzInput))
    bool started = inSess and not inSess[1]
    bool ended   = inSess[1] and not inSess
    if started
        hi := high
        lo := low
        hiBar := bar_index
        loBar := bar_index
        bx := box.new(bar_index, high, bar_index, low, border_color = color.new(c, 50), border_width = 1, bgcolor = color.new(c, 88), text = name, text_size = size.tiny, text_color = color.new(c, 10), text_halign = text.align_left, text_valign = text.align_top)
        mid := midInput ? line.new(bar_index, hl2, bar_index, hl2, color = color.new(c, 40), style = line.style_dotted) : na
    else if inSess and not na(bx)
        if high > hi
            hi := high
            hiBar := bar_index
        if low < lo
            lo := low
            loBar := bar_index
        bx.set_right(bar_index)
        bx.set_top(hi)
        bx.set_bottom(lo)
        bx.set_text(name + "  " + str.tostring(hi - lo, format.mintick))
        if not na(mid)
            mid.set_xy1(bx.get_left(), (hi + lo) / 2)
            mid.set_xy2(bar_index, (hi + lo) / 2)
    [started, ended, hi, lo, hiBar, loBar]

[asiaStart, asiaEnd, asiaHi, asiaLo, asiaHiBar, asiaLoBar] = killZone(asiaInput, showAsiaInput, asiaC, "Asia")
[lonStart, lonEnd, lonHi, lonLo, lonHiBar, lonLoBar]       = killZone(lonInput, showLonInput, lonC, "London")
[nyStart, nyEnd, nyHi, nyLo, nyHiBar, nyLoBar]             = killZone(nyInput, showNyInput, nyC, "NY AM")
[pmStart, pmEnd, pmHi, pmLo, pmHiBar, pmLoBar]             = killZone(pmInput, showPmInput, pmC, "NY PM")

// A finished session leaves its high and low as liquidity, anchored at the bar that made them.
addLevel(float price, int dir, int x, color c, string name) =>
    if showLiqInput and not na(price) and not na(x)
        line  ln = line.new(x, price, bar_index, price, color = color.new(c, 25), width = 1, style = line.style_dashed)
        label lb = label.new(bar_index, price, name, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = size.tiny)
        levels.push(Level.new(price = price, dir = dir, ln = ln, lb = lb))
        if levels.size() > maxLiqInput
            Level old = levels.shift()
            old.ln.delete()
            old.lb.delete()

if asiaEnd
    addLevel(asiaHi, 1, asiaHiBar, asiaC, "Asia H")
    addLevel(asiaLo, -1, asiaLoBar, asiaC, "Asia L")
if lonEnd
    addLevel(lonHi, 1, lonHiBar, lonC, "LDN H")
    addLevel(lonLo, -1, lonLoBar, lonC, "LDN L")
if nyEnd
    addLevel(nyHi, 1, nyHiBar, nyC, "NY H")
    addLevel(nyLo, -1, nyLoBar, nyC, "NY L")
if pmEnd
    addLevel(pmHi, 1, pmHiBar, pmC, "PM H")
    addLevel(pmLo, -1, pmLoBar, pmC, "PM L")

// Life cycle on closed bars: extend while untouched; when traded through, freeze the line (faded) and
// mark a sweep if the bar closed back on the original side.
bool sweptHigh = false
bool sweptLow  = false
if levels.size() > 0
    for i = levels.size() - 1 to 0
        Level lv = levels.get(i)
        bool takenUp = lv.dir == 1 and high > lv.price
        bool takenDn = lv.dir == -1 and low < lv.price
        bool taken   = takenUp or takenDn
        if taken and barstate.isconfirmed
            bool backInside = takenUp ? close < lv.price : close > lv.price
            lv.ln.set_x2(bar_index)
            lv.ln.set_style(line.style_dotted)
            lv.ln.set_color(color.new(textC, 55))
            lv.lb.delete()
            if backInside
                label.new(bar_index, lv.price, takenUp ? "▼ SWEEP" : "▲ SWEEP", style = takenUp ? label.style_label_down : label.style_label_up, color = takenUp ? bearC : bullC, textcolor = color.white, size = size.tiny)
                sweptHigh := sweptHigh or takenUp
                sweptLow  := sweptLow or takenDn
            levels.remove(i)
        else
            lv.ln.set_x2(bar_index)
            lv.lb.set_x(bar_index)

// ---------- Previous day / week (offset 1 + lookahead_on: confirmed values, no repainting) ----------
[pdh, pdl] = request.security(syminfo.tickerid, "1D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "1W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
float adr  = request.security(syminfo.tickerid, "1D", ta.sma(high - low, adrLenInput)[1], lookahead = barmerge.lookahead_on)

// One line + label per level, moved (never recreated) on the last bar.
levelLine(float price, string name, bool show, color c) =>
    var line  ln = line.new(na, na, na, na, color = c, style = line.style_dashed, width = 1)
    var label lb = label.new(na, na, name, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = size.tiny)
    if barstate.islast
        if show and not na(price)
            ln.set_xy1(bar_index - 60, price)
            ln.set_xy2(bar_index + 8, price)
            ln.set_color(c)
            lb.set_xy(bar_index + 8, price)
            lb.set_text(name + "  " + str.tostring(price, format.mintick))
            lb.set_textcolor(c)
        else
            ln.set_xy1(na, na)
            ln.set_xy2(na, na)
            lb.set_xy(na, na)

levelLine(pdh, "PDH", showPdInput and timeframe.isintraday, bearC)
levelLine(pdl, "PDL", showPdInput and timeframe.isintraday, bullC)
levelLine(pwh, "PWH", showPwInput and not timeframe.isweekly and not timeframe.ismonthly, color.new(bearC, 30))
levelLine(pwl, "PWL", showPwInput and not timeframe.isweekly and not timeframe.ismonthly, color.new(bullC, 30))

// ---------- Today's range vs ADR ----------
bool newDay = timeframe.change("D")
var float dHi = na
var float dLo = na
if newDay
    dHi := high
    dLo := low
else
    dHi := math.max(nz(dHi, high), high)
    dLo := math.min(nz(dLo, low), low)
float usedPct = adr > 0 ? (dHi - dLo) / adr * 100 : na

// ---------- Dashboard ----------
bool inAsia = not na(time(timeframe.period, asiaInput, tzInput))
bool inLon  = not na(time(timeframe.period, lonInput, tzInput))
bool inNy   = not na(time(timeframe.period, nyInput, tzInput))
bool inPm   = not na(time(timeframe.period, pmInput, tzInput))
string nowSess = inLon ? "London" : inNy ? "NY AM" : inPm ? "NY PM" : inAsia ? "Asia" : "Off-session"
color  nowC    = inLon ? lonC : inNy ? nyC : inPm ? pmC : inAsia ? asiaC : textC

dashPos = dashPosInput == "Top right" ? position.top_right : dashPosInput == "Bottom right" ? position.bottom_right : dashPosInput == "Top left" ? position.top_left : position.bottom_left
var table dash = table.new(dashPos, 2, 7, border_width = 1, border_color = color.new(#787B86, 85), frame_color = color.new(accentC, 40), frame_width = 1)

fmt(float v) =>
    na(v) ? "-" : str.tostring(v, format.mintick)

row(int r, string k, string v, color vc) =>
    dash.cell(0, r, k, text_color = textC, bgcolor = color.new(#131722, 10), text_size = size.small, text_halign = text.align_left)
    dash.cell(1, r, v, text_color = vc, bgcolor = color.new(#131722, 10), text_size = size.small, text_halign = text.align_right, text_font_family = font.family_monospace)

if showDashInput and barstate.islast
    dash.cell(0, 0, "NEXUS", text_color = color.white, bgcolor = color.new(accentC, 15), text_size = size.small)
    dash.cell(1, 0, "Sessions", text_color = color.white, bgcolor = color.new(accentC, 15), text_size = size.small)
    row(1, "Now", nowSess, nowC)
    row(2, "Asia range", fmt(asiaHi - asiaLo), asiaC)
    row(3, "Today range", fmt(dHi - dLo), textC)
    row(4, "ADR " + str.tostring(adrLenInput), fmt(adr), textC)
    row(5, "Range used", na(usedPct) ? "-" : str.tostring(usedPct, "#") + "%", na(usedPct) ? textC : color.from_gradient(usedPct, 40, 130, bullC, bearC))
    row(6, "PDH / PDL", fmt(pdh - close) + " / " + fmt(close - pdl), textC)

// ---------- Alerts ----------
// Crosses are computed on every bar first, then gated (v6 evaluates `and` lazily).
bool crossPdh = ta.crossover(close, pdh)
bool crossPdl = ta.crossunder(close, pdl)
bool pdhBreak = showPdInput and crossPdh
bool pdlBreak = showPdInput and crossPdl
bool anyStart = asiaStart or lonStart or nyStart or pmStart
alertcondition(anyStart, "Kill zone started", "Nexus Sessions: a kill zone started on {{ticker}} {{interval}}")
alertcondition(sweptHigh, "Session high swept", "Nexus Sessions: a session high was swept (wick above, close back below) on {{ticker}} {{interval}}")
alertcondition(sweptLow, "Session low swept", "Nexus Sessions: a session low was swept (wick below, close back above) on {{ticker}} {{interval}}")
alertcondition(pdhBreak, "Close above previous day high", "Nexus Sessions: close above PDH on {{ticker}} {{interval}}")
alertcondition(pdlBreak, "Close below previous day low", "Nexus Sessions: close below PDL on {{ticker}} {{interval}}")
