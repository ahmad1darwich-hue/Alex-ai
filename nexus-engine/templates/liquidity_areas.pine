//@version=6
indicator("Nexus Liquidity Areas - Sell / Buy Zones & Trade Plan", shorttitle = "NX Areas", overlay = true, max_boxes_count = 80, max_lines_count = 60, max_labels_count = 300)

// Sell areas sit where buy-side liquidity rests (at the latest swing highs), buy areas where sell-side liquidity rests
// (at the latest swing lows). Each area has a FIXED price range taken once from its swing candle (wick to body edge,
// height clamped in ATR); it is drawn as a strength box in one column just right of the last candle and removed when a
// bar closes beyond its far side. Against the trend an area reads "corrective only". Signal = the first visit to an
// area rejected by a close back out (confirmed bar). Each signal: EN at the close, SL beyond the area, TP1-TP4 in R;
// hits are marked on the candles (TP / SL), the open plan sits at the right edge, the table converts it to lots and cash.

// ---------- Inputs ----------
string GRP_A = "Areas"
bool   autoInput    = input.bool(true, "Auto swing length", group = GRP_A, tooltip = "5m and below: 5, up to 1h: 8, above: 10. Turn off to use the manual value.")
int    lenInput     = input.int(8, "Swing length (manual)", minval = 2, maxval = 50, group = GRP_A)
int    perSideInput = input.int(2, "Areas per side", minval = 1, maxval = 5, group = GRP_A)
float  minHInput    = input.float(0.3, "Min area height (x ATR)", minval = 0.05, step = 0.05, group = GRP_A)
float  maxHInput    = input.float(1.0, "Max area height (x ATR)", minval = 0.2, step = 0.1, group = GRP_A)
float  eqTolInput   = input.float(0.15, "Equal highs / lows tolerance (x ATR)", minval = 0.02, step = 0.01, group = GRP_A)
bool   showLiqInput = input.bool(true, "Liquidity lines at the swings", group = GRP_A)
string langInput    = input.string("Arabic", "Box text", options = ["Arabic", "English"], group = GRP_A)
string GRP_T = "Trade plan"
bool   showSigInput = input.bool(true, "Buy / Sell signals", group = GRP_T)
float  slBufInput   = input.float(0.3, "SL beyond the area (x ATR)", minval = 0.0, step = 0.1, group = GRP_T)
float  tp1Input     = input.float(4.4, "TP1 (R)", minval = 0.5, step = 0.1, group = GRP_T)
float  tp2Input     = input.float(9.0, "TP2 (R)", minval = 0.5, step = 0.1, group = GRP_T)
float  tp3Input     = input.float(11.5, "TP3 (R)", minval = 0.5, step = 0.1, group = GRP_T)
float  tp4Input     = input.float(15.0, "TP4 (R)", minval = 0.5, step = 0.1, group = GRP_T)
int    expiryInput  = input.int(150, "Close the plan after (bars)", minval = 10, group = GRP_T)
string GRP_R = "Risk table"
bool   showRiskInput = input.bool(true, "Risk table", group = GRP_R)
float  balInput      = input.float(1000, "Balance ($)", minval = 1, group = GRP_R)
float  riskInput     = input.float(4.0, "Risk per trade (%)", minval = 0.1, step = 0.1, group = GRP_R)
float  lotInput      = input.float(100, "Units per lot", minval = 1, group = GRP_R, tooltip = "Gold: 100 oz per lot. FX: 100000. Indices / crypto: check your broker.")
string GRP_L = "Layers"
bool   showMtfInput  = input.bool(true, "Multi-timeframe table", group = GRP_L)
bool   colorBarInput = input.bool(true, "Color candles by strength", group = GRP_L)
string GRP_S = "Style"
string themeInput = input.string("Neon", "Theme", options = ["Neon", "Classic", "Minimal", "Mono"], group = GRP_S)

// ---------- Theme ----------
pick(color neon, color classic, color minimal, color mono) =>
    themeInput == "Neon" ? neon : themeInput == "Classic" ? classic : themeInput == "Minimal" ? minimal : mono

color bullC    = pick(#00E676, #089981, #26A69A, #D1D4DC)
color bearC    = pick(#FF1744, #F23645, #EF5350, #787B86)
color sellBox  = pick(#5C1F2B, #6B2232, #4A2A30, #3A3D46)
color buyBox   = pick(#1E4D2B, #1F4D3A, #24453A, #3A3D46)
color tpC      = pick(#2962FF, #2962FF, #5B7BD5, #B2B5BE)
color entryC   = pick(#FF9800, #F57C00, #C9A227, #9598A1)
color neutralC = pick(#8C8FA3, #787B86, #9598A1, #5D606B)
color textC    = pick(#E0E3EB, #D1D4DC, #C3C6CF, #B2B5BE)

// ---------- Types & state ----------
type Area
    box   bx
    line  liq
    float top
    float bot
    float level   // the swing price (where the stops rest)
    int   dir     // -1 = sell area (at highs), 1 = buy area (at lows)
    int   score
    bool  used    // the first visit is over (or gave its signal)
    bool  visiting
    int   born

type Plan
    int   dir
    float en
    float sl
    float tp1
    float tp2
    float tp3
    float tp4
    int   bar
    int   hits    // how many TPs were reached
    bool  open

var array<Area> areas = array.new<Area>()
var Plan plan = Plan.new(0, na, na, na, na, na, na, na, 0, false)
var array<label> edge = array.new<label>()
var array<box> entries = array.new<box>() // entry marks of the last signals, newest 10
var int wins = 0
var int losses = 0

int   tfSec = timeframe.in_seconds()
int   len   = autoInput ? (tfSec <= 300 ? 5 : tfSec <= 3600 ? 8 : 10) : lenInput
float atr   = ta.atr(14)
float ph    = ta.pivothigh(high, len, len)
float pl    = ta.pivotlow(low, len, len)
float emaF  = ta.ema(close, 50)
float emaS  = ta.ema(close, 200)
int   trend = emaF > emaS and close > emaS ? 1 : emaF < emaS and close < emaS ? -1 : 0
// how far price travelled away from the swing in the len bars after it (displacement, in ATR)
float dropAfter = ta.highest(high, len + 1) - ta.lowest(low, len)
float riseAfter = ta.highest(high, len) - ta.lowest(low, len + 1)
bool  ar = langInput == "Arabic"

// ---------- Helpers ----------
areaText(Area a) =>
    bool counter = a.dir == -1 ? trend == 1 : trend == -1
    string pct = str.tostring(a.score) + "%"
    a.dir == -1 ? (counter ? (ar ? "بيع تصحيحي فقط" : "Corrective sell only") : (ar ? "قوة البيع: " : "Sell strength: ") + pct) : (counter ? (ar ? "شراء تصحيحي فقط" : "Corrective buy only") : (ar ? "قوة الشراء: " : "Buy strength: ") + pct)

// The price range never changes; only the column position follows the last candle.
paint(Area a) =>
    a.bx.set_left(bar_index - 3)
    a.bx.set_right(bar_index + 12)
    a.bx.set_bgcolor(color.new(a.dir == -1 ? sellBox : buyBox, a.used ? 25 : 5))
    a.bx.set_text(areaText(a))
    if not na(a.liq)
        a.liq.set_x2(bar_index + 12)

// A new swing: stacks on a live area of the same side within the tolerance (equal highs / lows), or opens a new area.
addArea(int dir, int x, float level, float wickEdge, float bodyEdge, float travel) =>
    bool stacked = false
    for a in areas
        if not stacked and a.dir == dir and math.abs(a.level - level) <= eqTolInput * atr
            a.score := math.min(95, a.score + 10)
            stacked := true
    if not stacked
        float h   = math.min(math.max(math.abs(wickEdge - bodyEdge), minHInput * atr), maxHInput * atr)
        float top = dir == -1 ? wickEdge : wickEdge + h
        float bot = dir == -1 ? wickEdge - h : wickEdge
        int   sc  = int(math.min(95, 45 + math.min(travel / atr, 4.0) * 10 + ((dir == -1 and trend == -1) or (dir == 1 and trend == 1) ? 10 : 0)))
        box   b   = box.new(bar_index - 3, top, bar_index + 12, bot, border_width = 0, text_size = size.small, text_color = textC, text_halign = text.align_center, text_valign = text.align_center)
        line  l   = showLiqInput ? line.new(x, level, bar_index + 12, level, color = color.new(dir == -1 ? bearC : bullC, 35), style = line.style_dotted, width = 1) : na
        Area  a   = Area.new(b, l, top, bot, level, dir, sc, false, false, bar_index)
        paint(a)
        areas.push(a)
        int same = 0
        for k = areas.size() - 1 to 0
            Area q = areas.get(k)
            if q.dir == dir
                same += 1
                if same > perSideInput
                    q.bx.delete()
                    q.liq.delete()
                    areas.remove(k)
    stacked

mark(int dir, float y, string txt, color c) =>
    label.new(bar_index, y, txt, style = dir == 1 ? label.style_label_down : label.style_label_up, color = c, textcolor = color.white, size = size.tiny)

// ---------- New areas from confirmed swings ----------
if not na(atr)
    if not na(ph)
        addArea(-1, bar_index - len, ph, ph, math.max(open[len], close[len]), dropAfter)
    if not na(pl)
        addArea(1, bar_index - len, pl, pl, math.min(open[len], close[len]), riseAfter)

// ---------- Plan: TP / SL marks on the candles (SL from the signal bar on, targets from the next bar) ----------
if barstate.isconfirmed and plan.open and bar_index > plan.bar
    bool hitSL = plan.dir == -1 ? high >= plan.sl : low <= plan.sl
    float nextTp = plan.hits == 0 ? plan.tp1 : plan.hits == 1 ? plan.tp2 : plan.hits == 2 ? plan.tp3 : plan.tp4
    bool hitTP = plan.dir == -1 ? low <= nextTp : high >= nextTp
    if hitSL
        mark(plan.dir == -1 ? -1 : 1, plan.dir == -1 ? high : low, "SL", bearC)
        losses += plan.hits == 0 ? 1 : 0
        plan.open := false
    else if hitTP
        plan.hits += 1
        mark(plan.dir == -1 ? -1 : 1, plan.dir == -1 ? low : high, "TP", tpC)
        wins += plan.hits == 1 ? 1 : 0
        if plan.hits >= 4
            plan.open := false
    else if bar_index - plan.bar >= expiryInput
        plan.open := false

// ---------- Life cycle and signals (confirmed bars only) ----------
bool sigSell = false
bool sigBuy  = false
if barstate.isconfirmed and areas.size() > 0
    for k = areas.size() - 1 to 0
        Area a = areas.get(k)
        if bar_index > a.born
            bool broken  = a.dir == -1 ? close > a.top : close < a.bot
            bool touched = a.dir == -1 ? high >= a.bot : low <= a.top
            if broken
                a.bx.delete()
                if not na(a.liq)
                    a.liq.delete()
                areas.remove(k)
            else
                // First visit only: a signal on any bar of that visit that closes back out of the area.
                if not touched and a.visiting
                    a.used := true
                    a.visiting := false
                if touched and not a.used
                    a.visiting := true
                    bool rejected = a.dir == -1 ? close < a.bot and close < open : close > a.top and close > open
                    if rejected
                        a.used := true
                    if rejected and showSigInput and not plan.open
                        float en = close
                        float sl = a.dir == -1 ? a.top + slBufInput * atr : a.bot - slBufInput * atr
                        float r  = math.abs(en - sl)
                        int   d  = -a.dir
                        plan := Plan.new(a.dir, en, sl, en + a.dir * r * tp1Input, en + a.dir * r * tp2Input, en + a.dir * r * tp3Input, en + a.dir * r * tp4Input, bar_index, 0, true)
                        sigSell := sigSell or a.dir == -1
                        sigBuy  := sigBuy or a.dir == 1
                        label.new(bar_index, a.dir == -1 ? high : low, a.dir == -1 ? "Sell" : "Buy", style = a.dir == -1 ? label.style_label_down : label.style_label_up, color = a.dir == -1 ? bearC : bullC, textcolor = color.white, size = size.small, tooltip = "First visit to the area rejected. EN " + str.tostring(en, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ".")
                        entries.push(box.new(bar_index, math.max(en, en + d * 0.25 * atr), bar_index + 15, math.min(en, en + d * 0.25 * atr), border_width = 0, bgcolor = color.new(entryC, 55)))
                        if entries.size() > 10
                            entries.shift().delete()
                paint(a)

// ---------- The open plan at the right edge ----------
if barstate.islast
    for lb in edge
        lb.delete()
    edge.clear()
    if not na(plan.en) and plan.open
        int x = bar_index + 30
        edge.push(label.new(x, plan.en, "EN", style = label.style_label_left, color = neutralC, textcolor = color.white, size = size.small))
        edge.push(label.new(x, plan.sl, "SL", style = label.style_label_left, color = bearC, textcolor = color.white, size = size.small))
        edge.push(label.new(x, plan.tp1, "TP 1", style = label.style_label_left, color = bullC, textcolor = color.white, size = size.small))
        edge.push(label.new(x, plan.tp2, "TP 2", style = label.style_label_left, color = bullC, textcolor = color.white, size = size.small))
        edge.push(label.new(x, plan.tp3, "TP 3", style = label.style_label_left, color = bullC, textcolor = color.white, size = size.small))
        edge.push(label.new(x, plan.tp4, "TP 4", style = label.style_label_left, color = bullC, textcolor = color.white, size = size.small))

// ---------- Risk table: balance, risk %, lots and the cash at SL / each TP ----------
var table risk = table.new(position.top_right, 3, 6, border_width = 1, border_color = color.new(#787B86, 60), bgcolor = color.new(#131722, 5))
cellR(int c, int r, string v, color tc) =>
    risk.cell(c, r, v, text_color = tc, text_size = size.small)

if showRiskInput and barstate.islast
    float riskCash = balInput * riskInput / 100
    float slDist   = na(plan.en) ? na : math.abs(plan.en - plan.sl)
    float lots     = na(slDist) or slDist == 0 ? na : riskCash / (slDist * syminfo.pointvalue * lotInput)
    cellR(0, 0, "Balance", textC)
    cellR(1, 0, "Risk %", textC)
    cellR(2, 0, "Lots", textC)
    cellR(0, 1, "$" + str.tostring(balInput, "#"), textC)
    cellR(1, 1, str.tostring(riskInput, "#.#"), textC)
    cellR(2, 1, na(lots) ? "-" : str.tostring(lots, "#.###"), textC)
    cellR(0, 2, "SL", bearC)
    cellR(1, 2, "-1", bearC)
    cellR(2, 2, "$" + str.tostring(riskCash, "#.00"), bearC)
    cellR(0, 3, "TP #1", bullC)
    cellR(1, 3, str.tostring(tp1Input, "#.#"), bullC)
    cellR(2, 3, "$" + str.tostring(riskCash * tp1Input, "#.00"), bullC)
    cellR(0, 4, "TP #2", bullC)
    cellR(1, 4, str.tostring(tp2Input, "#.#"), bullC)
    cellR(2, 4, "$" + str.tostring(riskCash * tp2Input, "#.00"), bullC)
    cellR(0, 5, "TP #3", bullC)
    cellR(1, 5, str.tostring(tp3Input, "#.#"), bullC)
    cellR(2, 5, "$" + str.tostring(riskCash * tp3Input, "#.00"), bullC)

// ---------- Multi-timeframe trend (closed bars of each timeframe) ----------
tfTrend() =>
    float f = ta.ema(close, 50)
    float s = ta.ema(close, 200)
    f[1] > s[1] and close[1] > s[1] ? 1 : f[1] < s[1] and close[1] < s[1] ? -1 : 0

int m5  = request.security(syminfo.tickerid, "5", tfTrend(), lookahead = barmerge.lookahead_on)
int m15 = request.security(syminfo.tickerid, "15", tfTrend(), lookahead = barmerge.lookahead_on)
int m30 = request.security(syminfo.tickerid, "30", tfTrend(), lookahead = barmerge.lookahead_on)
int h1  = request.security(syminfo.tickerid, "60", tfTrend(), lookahead = barmerge.lookahead_on)
int h4  = request.security(syminfo.tickerid, "240", tfTrend(), lookahead = barmerge.lookahead_on)

var table mtf = table.new(position.bottom_right, 2, 6, border_width = 1, border_color = color.new(#787B86, 60), bgcolor = color.new(#131722, 5))
cellM(int r, string tf, int t) =>
    mtf.cell(0, r, tf, text_color = color.white, bgcolor = color.new(t == 1 ? bullC : t == -1 ? bearC : neutralC, 30), text_size = size.small)
    mtf.cell(1, r, t == 1 ? "▲ Up" : t == -1 ? "▼ Down" : "● Range", text_color = t == 1 ? bullC : t == -1 ? bearC : neutralC, text_size = size.small)

if showMtfInput and barstate.islast
    mtf.cell(0, 0, "MTF", text_color = textC, text_size = size.small)
    mtf.cell(1, 0, "Trend", text_color = textC, text_size = size.small)
    cellM(1, "M5", m5)
    cellM(2, "M15", m15)
    cellM(3, "M30", m30)
    cellM(4, "1H", h1)
    cellM(5, "4H", h4)

// ---------- Candles by strength: strong / weak bull, strong / weak bear ----------
float body = math.abs(close - open)
bool  strongBar = body >= 0.5 * nz(atr, body)
color candleC = close >= open ? (strongBar ? pick(#76FF03, #089981, #26A69A, #D1D4DC) : pick(#FFD600, #4DB6AC, #80CBC4, #9598A1)) : (strongBar ? pick(#FF1744, #F23645, #EF5350, #787B86) : pick(#AA00FF, #9575CD, #B39DDB, #5D606B))
barcolor(colorBarInput ? candleC : na)

// ---------- Alerts ----------
alertcondition(sigSell, "Sell signal", "Nexus Areas: SELL - sell area rejected on {{ticker}} {{interval}} at {{close}}")
alertcondition(sigBuy, "Buy signal", "Nexus Areas: BUY - buy area rejected on {{ticker}} {{interval}} at {{close}}")
