//@version=6
indicator("Nexus Signals - Confluence Entries & Trade Manager", shorttitle = "NX Signals", overlay = true, max_lines_count = 200, max_labels_count = 300, max_boxes_count = 50)

// ---------- Inputs ----------
string GRP_S = "Signal engine"
bool   autoInput      = input.bool(true, "Auto settings", group = GRP_S, tooltip = "Picks the EMA pair from the chart timeframe: 5m and below 9 / 21, intraday 12 / 26, 4h and above 21 / 55. Turn off to use the manual lengths below.")
int    fastLenInput   = input.int(9, "Fast EMA (manual)", minval = 1, group = GRP_S)
int    slowLenInput   = input.int(21, "Slow EMA (manual)", minval = 2, group = GRP_S)
int    trendLenInput  = input.int(200, "Trend EMA", minval = 2, group = GRP_S)
int    minScoreInput  = input.int(3, "Minimum confluence (of 5)", minval = 1, maxval = 5, group = GRP_S, tooltip = "Each cross is scored on 5 checks: trend side of the trend EMA, RSI side of 50, ADX strength, volume above average (counted as passed when the symbol has no volume) and higher-timeframe agreement. 4-5 = grade A, below = grade B.")
bool   onlyAInput     = input.bool(false, "Grade A only", group = GRP_S)
int    adxMinInput    = input.int(20, "ADX at least", minval = 1, group = GRP_S)
float  volMultInput   = input.float(1.0, "Volume at least x average (20)", minval = 0.1, step = 0.1, group = GRP_S)
bool   useHtfInput    = input.bool(true, "Higher-timeframe check", group = GRP_S, inline = "htf")
string htfInput       = input.timeframe("240", "", group = GRP_S, inline = "htf", tooltip = "Close vs EMA 50 of the last CLOSED higher-timeframe bar, so it does not repaint.")
float  lateInput      = input.float(2.0, "Late-entry veto (ATR from slow EMA)", minval = 0.5, step = 0.25, group = GRP_S, tooltip = "Skips a cross when price is already this far from the slow EMA - chasing a stretched move. Skipped signals are counted in the dashboard.")
int    cooldownInput  = input.int(3, "Minimum bars between signals", minval = 0, group = GRP_S)

string GRP_R = "Stop & targets"
string stopModeInput  = input.string("Swing", "Stop", options = ["Swing", "ATR"], group = GRP_R, tooltip = "Swing: beyond the lowest low / highest high of the last bars plus a buffer. ATR: a fixed ATR distance. Both are kept between the min and max distance below.")
int    swingLenInput  = input.int(10, "Swing lookback", minval = 2, group = GRP_R, inline = "sw")
float  bufferInput    = input.float(0.3, "buffer (ATR)", minval = 0, step = 0.05, group = GRP_R, inline = "sw")
float  slMultInput    = input.float(1.5, "ATR stop (x ATR)", minval = 0.1, step = 0.1, group = GRP_R)
float  minStopInput   = input.float(0.5, "Stop distance min (ATR)", minval = 0.1, step = 0.1, group = GRP_R, inline = "mm")
float  maxStopInput   = input.float(3.0, "max", minval = 0.2, step = 0.1, group = GRP_R, inline = "mm")
int    atrLenInput    = input.int(14, "ATR length", minval = 1, group = GRP_R)
float  tp1RInput      = input.float(1.0, "TP1 (R)", minval = 0.1, step = 0.25, group = GRP_R, inline = "tp", tooltip = "Targets in multiples of the stop distance (R). The record assumes one third of the position is closed at each target.")
float  tp2RInput      = input.float(2.0, "TP2", minval = 0.1, step = 0.25, group = GRP_R, inline = "tp")
float  tp3RInput      = input.float(3.0, "TP3", minval = 0.1, step = 0.25, group = GRP_R, inline = "tp")
bool   beInput        = input.bool(true, "Stop to break-even after TP1", group = GRP_R)
bool   trailInput     = input.bool(true, "Trail the stop after TP2", group = GRP_R, inline = "tr")
float  trailMultInput = input.float(2.0, "x ATR", minval = 0.5, step = 0.1, group = GRP_R, inline = "tr")
bool   oppExitInput   = input.bool(true, "Exit on an opposite signal", group = GRP_R)

string GRP_L = "Layers"
bool   showSigInput   = input.bool(true, "BUY / SELL labels", group = GRP_L, inline = "l1")
bool   showPlanInput  = input.bool(true, "Trade plan (last signal)", group = GRP_L, inline = "l1")
bool   showEmasInput  = input.bool(true, "EMA cloud", group = GRP_L, inline = "l2")
bool   colorBarsInput = input.bool(false, "Color candles by position", group = GRP_L, inline = "l2")

string GRP_D = "Dashboard"
bool   showDashInput  = input.bool(true, "Show dashboard", group = GRP_D)
string dashPosInput   = input.string("Top right", "Position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = GRP_D)

string GRP_ST = "Style"
string themeInput = input.string("Neon", "Theme", options = ["Neon", "Classic", "Minimal", "Mono"], group = GRP_ST)

// ---------- Theme ----------
pick(color neon, color classic, color minimal, color mono) =>
    themeInput == "Neon" ? neon : themeInput == "Classic" ? classic : themeInput == "Minimal" ? minimal : mono

color bullC    = pick(#00E5A0, #089981, #26A69A, #D1D4DC)
color bearC    = pick(#FF3D71, #F23645, #EF5350, #787B86)
color accentC  = pick(#7C4DFF, #2962FF, #B2B5BE, #E0E3EB)
color neutralC = pick(#8C8FA3, #787B86, #9598A1, #5D606B)
color textC    = pick(#9598A1, #787B86, #9598A1, #B2B5BE)

// ---------- Calculations ----------
int   tfSec    = timeframe.in_seconds()
int   fastLen  = autoInput ? (tfSec <= 300 ? 9 : tfSec < 14400 ? 12 : 21) : fastLenInput
int   slowLen  = autoInput ? (tfSec <= 300 ? 21 : tfSec < 14400 ? 26 : 55) : math.max(slowLenInput, fastLenInput + 1)
float fastEma  = ta.ema(close, fastLen)
float slowEma  = ta.ema(close, slowLen)
float trendEma = ta.ema(close, trendLenInput)
float rsi      = ta.rsi(close, 14)
float atr      = ta.atr(atrLenInput)
[diPlus, diMinus, adx] = ta.dmi(14, 14)
float swingLo  = ta.lowest(low, swingLenInput)
float swingHi  = ta.highest(high, swingLenInput)
bool  crossUp  = ta.crossover(fastEma, slowEma)
bool  crossDn  = ta.crossunder(fastEma, slowEma)

// Volume check is skipped (counted as passed) on symbols without volume, such as many forex and index feeds.
bool  hasVol = ta.cum(nz(volume)) > 0
float volAvg = ta.sma(nz(volume), 20)
bool  volOk  = not hasVol or nz(volume) >= volAvg * volMultInput

// Higher-timeframe bias from the last closed HTF bar (offset + lookahead_on = no repainting).
[htfClose, htfEma] = request.security(syminfo.tickerid, htfInput, [close[1], ta.ema(close, 50)[1]], lookahead = barmerge.lookahead_on)

// Confluence score 0-5 for a direction.
scoreOf(int d) =>
    int s = 0
    s += (d == 1 ? close > trendEma : close < trendEma) ? 1 : 0
    s += (d == 1 ? rsi > 50 : rsi < 50) ? 1 : 0
    s += adx >= adxMinInput ? 1 : 0
    s += volOk ? 1 : 0
    s += (not useHtfInput or (d == 1 ? htfClose > htfEma : htfClose < htfEma)) ? 1 : 0
    s

int scoreL = scoreOf(1)
int scoreS = scoreOf(-1)

// ---------- Trade state (one idea at a time) ----------
var int    pos        = 0
var float  entry      = na
var float  stop       = na
var float  risk       = na
var float  tp1        = na
var float  tp2        = na
var float  tp3        = na
var int    hitCount   = 0
var float  realized   = 0.0
var string stopMode   = "Initial"
var string grade      = ""
var int    lastSigBar = na
var int    trades     = 0
var int    wins       = 0
var float  totalR     = 0.0
var int    lateSkips  = 0
var line   stopLn     = na
var label  stopLb     = na
var array<line>  planLines  = array.new<line>()
var array<label> planLabels = array.new<label>()
var array<box>   planBoxes  = array.new<box>()

bool buySig = false
bool sellSig = false
bool sigA = false
bool tp1Ev = false
bool tp2Ev = false
bool tp3Ev = false
bool slEv = false
bool beEv = false

mark(float price, string txt, color c, bool below) =>
    label.new(bar_index, price, txt, style = below ? label.style_label_up : label.style_label_down, color = color.new(c, 100), textcolor = c, size = size.tiny)

// 1) Candidate signal on a confirmed bar: cross + confluence + grade + cooldown + late-entry veto.
int cand = 0
if barstate.isconfirmed and not na(atr)
    int d = crossUp ? 1 : crossDn ? -1 : 0
    if d != 0 and d != pos
        int  sc   = d == 1 ? scoreL : scoreS
        bool a    = sc >= 4
        bool cool = na(lastSigBar) or bar_index - lastSigBar >= cooldownInput
        if sc >= minScoreInput and (a or not onlyAInput) and cool
            if math.abs(close - slowEma) > lateInput * atr
                lateSkips += 1
            else
                cand := d

// 2) Manage the open trade (the entry bar itself is never tested; stop is checked before targets).
if barstate.isconfirmed and pos != 0 and bar_index > lastSigBar
    bool   isL     = pos == 1
    color  tc      = isL ? bullC : bearC
    float  exitR   = na
    string exitTxt = ""
    float  exitPx  = na
    if (isL and low <= stop) or (not isL and high >= stop)
        exitR   := realized + (3 - hitCount) / 3.0 * pos * (stop - entry) / risk
        exitTxt := stopMode == "Initial" ? "✕ SL" : stopMode == "Break-even" ? "■ BE" : "■ TRAIL"
        exitPx  := stop
        slEv    := true
    else
        if hitCount == 0 and (isL ? high >= tp1 : low <= tp1)
            hitCount := 1
            realized += tp1RInput / 3
            tp1Ev    := true
            if showPlanInput
                planLabels.push(mark(tp1, "◆ TP1", tc, not isL))
        if hitCount == 1 and (isL ? high >= tp2 : low <= tp2)
            hitCount := 2
            realized += tp2RInput / 3
            tp2Ev    := true
            if showPlanInput
                planLabels.push(mark(tp2, "◆ TP2", tc, not isL))
        if hitCount == 2 and (isL ? high >= tp3 : low <= tp3)
            hitCount := 3
            realized += tp3RInput / 3
            tp3Ev    := true
            exitR    := realized
            exitTxt  := "◆ TP3"
            exitPx   := tp3
        else if cand == -pos and oppExitInput
            exitR   := realized + (3 - hitCount) / 3.0 * pos * (close - entry) / risk
            exitTxt := "• EXIT"
            exitPx  := close
    if na(exitR)
        // Protect the open trade: break-even after TP1, ATR trail (ratchet only) after TP2.
        if hitCount >= 1 and beInput and stopMode == "Initial" and (isL ? entry > stop : entry < stop)
            stop     := entry
            stopMode := "Break-even"
            beEv     := true
        if hitCount >= 2 and trailInput
            float t  = close - pos * trailMultInput * atr
            float ns = isL ? math.max(stop, t) : math.min(stop, t)
            if ns != stop
                stop     := ns
                stopMode := "Trailing"
        if showPlanInput and not na(stopLn)
            stopLn.set_y1(stop)
            stopLn.set_y2(stop)
            stopLb.set_y(stop)
            stopLb.set_text((stopMode == "Initial" ? "SL " : stopMode == "Break-even" ? "BE " : "TRAIL ") + str.tostring(stop, format.mintick))
    else
        trades += 1
        wins   += exitR > 0 ? 1 : 0
        totalR += exitR
        pos    := 0
        if showPlanInput
            planLabels.push(mark(exitPx, exitTxt, exitTxt == "✕ SL" ? neutralC : tc, not isL))
            for l in planLines
                l.set_x2(bar_index)
            for b in planBoxes
                b.set_right(bar_index)
            for lb in planLabels
                if lb.get_x() > bar_index
                    lb.set_x(bar_index)

// 3) Open the new trade when flat.
if cand != 0 and pos == 0
    int   d       = cand
    int   sc      = d == 1 ? scoreL : scoreS
    float rawRisk = stopModeInput == "Swing" ? (d == 1 ? close - (swingLo - bufferInput * atr) : swingHi + bufferInput * atr - close) : slMultInput * atr
    float r       = math.min(math.max(rawRisk, minStopInput * atr), math.max(maxStopInput, minStopInput) * atr)
    pos        := d
    entry      := close
    risk       := r
    stop       := close - d * r
    tp1        := close + d * r * tp1RInput
    tp2        := close + d * r * tp2RInput
    tp3        := close + d * r * tp3RInput
    hitCount   := 0
    realized   := 0.0
    stopMode   := "Initial"
    grade      := sc >= 4 ? "A" : "B"
    lastSigBar := bar_index
    buySig     := d == 1
    sellSig    := d == -1
    sigA       := sc >= 4
    color c = d == 1 ? bullC : bearC
    if showSigInput
        label.new(bar_index, d == 1 ? low - atr * 0.4 : high + atr * 0.4, (d == 1 ? "▲ BUY • " : "▼ SELL • ") + grade, style = d == 1 ? label.style_label_up : label.style_label_down, color = sigA ? c : color.new(c, 40), textcolor = color.white, size = size.small, tooltip = "Confluence " + str.tostring(sc) + "/5 • entry " + str.tostring(entry, format.mintick) + " • stop " + str.tostring(stop, format.mintick) + " • TP1 " + str.tostring(tp1, format.mintick))
    if showPlanInput
        for l in planLines
            l.delete()
        for lb in planLabels
            lb.delete()
        for b in planBoxes
            b.delete()
        planLines.clear()
        planLabels.clear()
        planBoxes.clear()
        int x2 = bar_index + 10
        planBoxes.push(box.new(bar_index, math.max(entry, stop), x2, math.min(entry, stop), border_color = color.new(bearC, 75), bgcolor = color.new(bearC, 88)))
        planBoxes.push(box.new(bar_index, math.max(entry, tp3), x2, math.min(entry, tp3), border_color = color.new(bullC, 75), bgcolor = color.new(bullC, 90)))
        planLines.push(line.new(bar_index, entry, x2, entry, color = color.new(textC, 20), width = 1))
        stopLn := line.new(bar_index, stop, x2, stop, color = bearC, width = 2)
        planLines.push(stopLn)
        planLines.push(line.new(bar_index, tp1, x2, tp1, color = color.new(bullC, 40), style = line.style_dashed))
        planLines.push(line.new(bar_index, tp2, x2, tp2, color = color.new(bullC, 30), style = line.style_dashed))
        planLines.push(line.new(bar_index, tp3, x2, tp3, color = color.new(bullC, 20), style = line.style_dashed))
        planLabels.push(label.new(x2, entry, "Entry " + str.tostring(entry, format.mintick), style = label.style_label_left, color = color.new(textC, 100), textcolor = textC, size = size.tiny))
        stopLb := label.new(x2, stop, "SL " + str.tostring(stop, format.mintick), style = label.style_label_left, color = color.new(bearC, 100), textcolor = bearC, size = size.tiny)
        planLabels.push(stopLb)
        planLabels.push(label.new(x2, tp1, "TP1 " + str.tostring(tp1RInput, "#.##") + "R " + str.tostring(tp1, format.mintick), style = label.style_label_left, color = color.new(bullC, 100), textcolor = bullC, size = size.tiny))
        planLabels.push(label.new(x2, tp2, "TP2 " + str.tostring(tp2RInput, "#.##") + "R " + str.tostring(tp2, format.mintick), style = label.style_label_left, color = color.new(bullC, 100), textcolor = bullC, size = size.tiny))
        planLabels.push(label.new(x2, tp3, "TP3 " + str.tostring(tp3RInput, "#.##") + "R " + str.tostring(tp3, format.mintick), style = label.style_label_left, color = color.new(bullC, 100), textcolor = bullC, size = size.tiny))

// The open plan follows price; a finished plan stays frozen where it ended.
if pos != 0 and showPlanInput and bar_index > lastSigBar
    for l in planLines
        l.set_x2(bar_index + 10)
    for b in planBoxes
        b.set_right(bar_index + 10)
    for lb in planLabels
        if lb.get_x() > bar_index
            lb.set_x(bar_index + 10)

// ---------- Visuals ----------
color cloudC = fastEma >= slowEma ? bullC : bearC
pFast = plot(showEmasInput ? fastEma : na, "Fast EMA", color = color.new(cloudC, 20), linewidth = 1)
plot(showEmasInput ? slowEma : na, "Slow EMA glow", color = color.new(cloudC, 85), linewidth = 7, display = display.pane)
pSlow = plot(showEmasInput ? slowEma : na, "Slow EMA", color = cloudC, linewidth = 2)
fill(pFast, pSlow, color = color.from_gradient(math.abs(fastEma - slowEma) / math.max(atr, syminfo.mintick), 0, 1.5, color.new(cloudC, 92), color.new(cloudC, 75)), title = "EMA cloud")
plot(showEmasInput ? trendEma : na, "Trend EMA", color = color.new(neutralC, 30), linewidth = 1)
barcolor(colorBarsInput and pos != 0 ? color.new(pos == 1 ? bullC : bearC, 20) : na, title = "Candle color")

// ---------- Dashboard ----------
dashPos = dashPosInput == "Top right" ? position.top_right : dashPosInput == "Bottom right" ? position.bottom_right : dashPosInput == "Top left" ? position.top_left : position.bottom_left
var table dash = table.new(dashPos, 2, 10, border_width = 1, border_color = color.new(#787B86, 85), frame_color = color.new(accentC, 40), frame_width = 1)

row(int r, string k, string v, color vc) =>
    dash.cell(0, r, k, text_color = textC, bgcolor = color.new(#131722, 10), text_size = size.small, text_halign = text.align_left)
    dash.cell(1, r, v, text_color = vc, bgcolor = color.new(#131722, 10), text_size = size.small, text_halign = text.align_right, text_font_family = font.family_monospace)

if showDashInput and barstate.islast
    color posC  = pos == 1 ? bullC : pos == -1 ? bearC : textC
    float openR = pos != 0 and risk > 0 ? realized + (3 - hitCount) / 3.0 * pos * (close - entry) / risk : na
    int   best  = math.max(scoreL, scoreS)
    float avgR  = trades > 0 ? totalR / trades : na
    dash.cell(0, 0, "NEXUS", text_color = color.white, bgcolor = color.new(accentC, 15), text_size = size.small)
    dash.cell(1, 0, "Signals", text_color = color.white, bgcolor = color.new(accentC, 15), text_size = size.small)
    row(1, "Position", pos == 1 ? "LONG • " + grade : pos == -1 ? "SHORT • " + grade : "FLAT", posC)
    row(2, "Confluence", str.tostring(best) + "/5 " + (scoreL >= scoreS ? "▲" : "▼"), color.from_gradient(best, 1, 5, textC, scoreL >= scoreS ? bullC : bearC))
    row(3, "Entry / stop", pos != 0 ? str.tostring(entry, format.mintick) + " / " + str.tostring(stop, format.mintick) : "-", posC)
    row(4, "Open result", na(openR) ? "-" : (openR >= 0 ? "+" : "") + str.tostring(openR, "#.##") + " R", na(openR) ? textC : openR >= 0 ? bullC : bearC)
    row(5, "Targets hit", pos == 0 ? "-" : hitCount == 0 ? "none" : hitCount == 1 ? "TP1" : hitCount == 2 ? "TP1 • TP2" : "TP1 • TP2 • TP3", hitCount > 0 ? bullC : textC)
    row(6, "Stop mode", pos == 0 ? "-" : stopMode, stopMode == "Initial" ? textC : accentC)
    row(7, "Trades / win", str.tostring(trades) + (trades > 0 ? " • " + str.tostring(wins * 100.0 / trades, "#") + "%" : ""), trades > 0 ? color.from_gradient(wins * 100.0 / trades, 35, 65, bearC, bullC) : textC)
    row(8, "Total R", trades > 0 ? (totalR >= 0 ? "+" : "") + str.tostring(totalR, "#.#") + " • avg " + str.tostring(avgR, "#.##") : "-", trades > 0 ? (totalR >= 0 ? bullC : bearC) : textC)
    row(9, "Late skipped", str.tostring(lateSkips), accentC)

// ---------- Alerts ----------
alertcondition(buySig, "BUY signal", "Nexus Signals: BUY {{ticker}} {{interval}} at {{close}}")
alertcondition(sellSig, "SELL signal", "Nexus Signals: SELL {{ticker}} {{interval}} at {{close}}")
alertcondition(sigA, "Grade A signal", "Nexus Signals: grade A signal on {{ticker}} {{interval}} at {{close}}")
alertcondition(tp1Ev, "TP1 hit", "Nexus Signals: TP1 hit on {{ticker}} {{interval}}")
alertcondition(tp2Ev, "TP2 hit", "Nexus Signals: TP2 hit on {{ticker}} {{interval}}")
alertcondition(tp3Ev, "TP3 hit", "Nexus Signals: TP3 hit on {{ticker}} {{interval}}")
alertcondition(slEv, "Stop hit", "Nexus Signals: stop hit on {{ticker}} {{interval}}")
alertcondition(beEv, "Stop moved to break-even", "Nexus Signals: stop moved to entry on {{ticker}} {{interval}}")
if buySig or sellSig
    alert((buySig ? "BUY " : "SELL ") + syminfo.ticker + " " + timeframe.period + " • grade " + grade + " | entry " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(stop, format.mintick) + " | TP1 " + str.tostring(tp1, format.mintick) + " | TP2 " + str.tostring(tp2, format.mintick) + " | TP3 " + str.tostring(tp3, format.mintick), alert.freq_once_per_bar_close)
