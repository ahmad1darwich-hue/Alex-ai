//@version=6
indicator("Nexus Fib & Pivots - Auto Swing Levels & Golden Zone", shorttitle = "NX Fib", overlay = true, max_lines_count = 100, max_labels_count = 150, max_boxes_count = 20)

// Auto Fibonacci on the last confirmed swing leg (big enough in ATR to matter): retracements, the golden zone
// (0.618 - 0.65) and extension targets, redrawn when a new leg forms. Floor pivots of the previous day / week / month
// (Classic or Fibonacci). A fib level that sits on a pivot is marked as confluence. One golden-zone reaction signal per leg.

// ---------- Inputs ----------
string GRP_F = "Auto Fibonacci"
bool   showFibInput = input.bool(true, "Auto Fibonacci", group = GRP_F)
bool   autoInput    = input.bool(true, "Auto swing length", group = GRP_F, tooltip = "5m and below: 8, intraday: 10, 4h and above: 12. Turn off to use the manual value.")
int    lenInput     = input.int(10, "Swing length (manual)", minval = 2, maxval = 60, group = GRP_F)
float  minLegInput  = input.float(3.0, "Min leg size (x ATR)", minval = 0.5, step = 0.5, group = GRP_F, tooltip = "Smaller legs are ignored, the previous fib stays.")
bool   showExtInput = input.bool(true, "Extension targets (1.272 / 1.618)", group = GRP_F)
bool   showSigInput = input.bool(true, "Golden zone reaction signal", group = GRP_F, tooltip = "Once per leg: price trades into the golden zone and a candle closes back out of it in the leg's direction.")
string GRP_P = "Pivots"
bool   showPivInput = input.bool(true, "Pivot levels", group = GRP_P)
string pivPerInput  = input.string("Auto", "Period", options = ["Auto", "Day", "Week", "Month"], group = GRP_P, tooltip = "Auto: daily pivots up to 1h, weekly up to 4h, monthly above.")
string pivTypeInput = input.string("Classic", "Type", options = ["Classic", "Fibonacci"], group = GRP_P)
string GRP_L = "Layers"
bool   showDashInput = input.bool(true, "Dashboard", group = GRP_L)
string GRP_S = "Style"
string themeInput = input.string("Neon", "Theme", options = ["Neon", "Classic", "Minimal", "Mono"], group = GRP_S)

// ---------- Theme ----------
pick(color neon, color classic, color minimal, color mono) =>
    themeInput == "Neon" ? neon : themeInput == "Classic" ? classic : themeInput == "Minimal" ? minimal : mono

color bullC    = pick(#00E5A0, #089981, #26A69A, #D1D4DC)
color bearC    = pick(#FF3D71, #F23645, #EF5350, #787B86)
color goldC    = pick(#FFC400, #FF9800, #C9A227, #E0E3EB)
color accentC  = pick(#7C4DFF, #2962FF, #B2B5BE, #B2B5BE)
color neutralC = pick(#8C8FA3, #787B86, #9598A1, #5D606B)
color textC    = pick(#9598A1, #787B86, #9598A1, #B2B5BE)

// ---------- State ----------
var array<float> fibR  = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0, -0.272, -0.618)
var array<line>  fibL  = array.new<line>()
var array<label> fibT  = array.new<label>()
var box   gzBox  = na
var float legHi  = na
var float legLo  = na
var int   legDir = 0
var bool  gzTouched = false
var bool  gzDone    = false
var array<line>  pivL  = array.new<line>()
var array<label> pivT  = array.new<label>()
var array<float> pivP  = array.new<float>()
var array<string> pivN = array.new<string>()
var array<line>  pivOld = array.new<line>() // the last two finished periods stay, faded

int   tfSec = timeframe.in_seconds()
int   len   = autoInput ? (tfSec <= 300 ? 8 : tfSec < 14400 ? 10 : 12) : lenInput
float atr   = ta.atr(14)
float ph    = ta.pivothigh(high, len, len)
float pl    = ta.pivotlow(low, len, len)

var float hiP = na
var int   hiB = na
var float loP = na
var int   loB = na
if not na(ph)
    hiP := ph
    hiB := bar_index - len
if not na(pl)
    loP := pl
    loB := bar_index - len

// Price of a ratio on the current leg: 0 = where the leg ended, 1 = where it started; negative = beyond the end.
fibPrice(float r) =>
    legDir == 1 ? legHi - r * (legHi - legLo) : legLo + r * (legHi - legLo)

fibColor(float r) =>
    r == 0.618 ? goldC : r < 0 ? (legDir == 1 ? bullC : bearC) : r == 0.0 or r == 1.0 ? neutralC : r == 0.5 ? textC : accentC

// ---------- A new leg: redraw the fib ----------
bool legNew = false
if showFibInput and (not na(ph) or not na(pl)) and not na(hiP) and not na(loP) and not na(atr) and math.abs(hiP - loP) >= minLegInput * atr
    legNew := true
    legHi  := hiP
    legLo  := loP
    legDir := hiB > loB ? 1 : -1
    gzTouched := false
    gzDone    := false
    for l in fibL
        l.delete()
    for t in fibT
        t.delete()
    fibL.clear()
    fibT.clear()
    if not na(gzBox)
        gzBox.delete()
    int x0 = math.min(hiB, loB)
    for r in fibR
        if r >= 0 or showExtInput
            float p = fibPrice(r)
            color c = fibColor(r)
            fibL.push(line.new(x0, p, bar_index + 15, p, color = color.new(c, r == 0.618 ? 0 : 35), width = r == 0.618 ? 2 : 1, style = r == 0.5 ? line.style_dotted : r < 0 ? line.style_dashed : line.style_solid))
            string name = r < 0 ? str.tostring(1 - r, "#.###") : str.tostring(r, "#.###")
            fibT.push(label.new(bar_index + 15, p, name + "  " + str.tostring(p, format.mintick), style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = size.small))
    gzBox := box.new(x0, fibPrice(0.618), bar_index + 15, fibPrice(0.65), border_color = color.new(goldC, 60), bgcolor = color.new(goldC, 82), text = "Golden zone", text_size = size.tiny, text_color = color.new(goldC, 20), text_halign = text.align_left)

// Every bar: levels run to the right edge.
for l in fibL
    l.set_x2(bar_index + 15)
for t in fibT
    t.set_x(bar_index + 15)
if not na(gzBox)
    gzBox.set_right(bar_index + 15)

// ---------- Golden zone reaction (once per leg, confirmed bars) ----------
bool gzReactUp = false
bool gzReactDn = false
bool gzTouchNow = false
if barstate.isconfirmed and legDir != 0 and not gzDone and not legNew
    float gTop = math.max(fibPrice(0.618), fibPrice(0.65))
    float gBot = math.min(fibPrice(0.618), fibPrice(0.65))
    bool  inZone = high >= gBot and low <= gTop
    if inZone and not gzTouched
        gzTouched  := true
        gzTouchNow := true
    bool startBroken = legDir == 1 ? close < legLo : close > legHi
    if startBroken
        gzDone := true
    else if gzTouched and (legDir == 1 ? close > gTop and close > open : close < gBot and close < open)
        gzDone := true
        gzReactUp := legDir == 1
        gzReactDn := legDir == -1
        if showSigInput
            label.new(bar_index, legDir == 1 ? low - atr * 0.4 : high + atr * 0.4, legDir == 1 ? "▲ GZ" : "▼ GZ", style = legDir == 1 ? label.style_label_up : label.style_label_down, color = legDir == 1 ? bullC : bearC, textcolor = color.white, size = size.small, tooltip = "Golden zone reaction: price retraced into 0.618 - 0.65 and closed back out with the leg. Invalid beyond " + str.tostring(legDir == 1 ? legLo : legHi, format.mintick) + "; targets " + str.tostring(fibPrice(0.0), format.mintick) + " then " + str.tostring(fibPrice(-0.272), format.mintick) + ".")

// ---------- Pivots of the previous period ----------
string pivTf = pivPerInput == "Day" ? "D" : pivPerInput == "Week" ? "W" : pivPerInput == "Month" ? "M" : tfSec <= 3600 ? "D" : tfSec <= 14400 ? "W" : "M"
[pH, pL, pC] = request.security(syminfo.tickerid, pivTf, [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
float P  = (pH + pL + pC) / 3
float rg = pH - pL
float R1 = pivTypeInput == "Classic" ? 2 * P - pL : P + 0.382 * rg
float S1 = pivTypeInput == "Classic" ? 2 * P - pH : P - 0.382 * rg
float R2 = pivTypeInput == "Classic" ? P + rg : P + 0.618 * rg
float S2 = pivTypeInput == "Classic" ? P - rg : P - 0.618 * rg
float R3 = pivTypeInput == "Classic" ? pH + 2 * (P - pL) : P + rg
float S3 = pivTypeInput == "Classic" ? pL - 2 * (pH - P) : P - rg

addPivot(string name, float price, color c, int w, string st) =>
    pivL.push(line.new(bar_index, price, bar_index + 15, price, color = c, width = w, style = st))
    pivT.push(label.new(bar_index, price, name, style = label.style_label_right, color = color.new(c, 100), textcolor = c, size = size.tiny, tooltip = name + " " + str.tostring(price, format.mintick)))
    pivP.push(price)
    pivN.push(name)

bool newPivPeriod = timeframe.change(pivTf)
if showPivInput and not na(P) and (newPivPeriod or pivL.size() == 0)
    for l in pivL
        l.set_x2(bar_index - 1)
        l.set_color(color.new(neutralC, 80))
        pivOld.push(l)
        if pivOld.size() > 14
            pivOld.shift().delete()
    for t in pivT
        t.delete()
    pivL.clear()
    pivT.clear()
    pivP.clear()
    pivN.clear()
    addPivot("P", P, accentC, 2, line.style_solid)
    addPivot("R1", R1, color.new(bearC, 25), 1, line.style_dashed)
    addPivot("R2", R2, color.new(bearC, 40), 1, line.style_dashed)
    addPivot("R3", R3, color.new(bearC, 55), 1, line.style_dashed)
    addPivot("S1", S1, color.new(bullC, 25), 1, line.style_dashed)
    addPivot("S2", S2, color.new(bullC, 40), 1, line.style_dashed)
    addPivot("S3", S3, color.new(bullC, 55), 1, line.style_dashed)
for l in pivL
    l.set_x2(bar_index + 15)

// ---------- Confluence: a fib level on a pivot gets a diamond ----------
if barstate.islast and fibT.size() > 0
    int k = 0
    for r in fibR
        if r >= 0 or showExtInput
            float p = fibPrice(r)
            bool near = false
            for q in pivP
                near := near or math.abs(q - p) <= 0.25 * atr
            string name = r < 0 ? str.tostring(1 - r, "#.###") : str.tostring(r, "#.###")
            if k < fibT.size()
                fibT.get(k).set_text((near ? "◆ " : "") + name + "  " + str.tostring(p, format.mintick))
            k += 1

// ---------- Dashboard ----------
var table dash = table.new(position.top_right, 2, 6, border_width = 1, border_color = color.new(#787B86, 85), frame_color = color.new(goldC, 40), frame_width = 1)
row(int r, string k, string v, color vc) =>
    dash.cell(0, r, k, text_color = textC, bgcolor = color.new(#131722, 10), text_size = size.small, text_halign = text.align_left)
    dash.cell(1, r, v, text_color = vc, bgcolor = color.new(#131722, 10), text_size = size.small, text_halign = text.align_right, text_font_family = font.family_monospace)

if showDashInput and barstate.islast
    float retr = legDir == 0 ? na : (legDir == 1 ? legHi - close : close - legLo) / (legHi - legLo) * 100
    string nearName = "-"
    float  nearDist = na
    if pivP.size() > 0
        for i = 0 to pivP.size() - 1
            float dd = math.abs(close - pivP.get(i))
            if na(nearDist) or dd < nearDist
                nearDist := dd
                nearName := pivN.get(i)
    dash.cell(0, 0, "NEXUS", text_color = color.black, bgcolor = color.new(goldC, 10), text_size = size.small)
    dash.cell(1, 0, "Fib & Pivots", text_color = color.black, bgcolor = color.new(goldC, 10), text_size = size.small)
    row(1, "Leg", legDir == 0 ? "-" : (legDir == 1 ? "Up ▲ " : "Down ▼ ") + str.tostring((legHi - legLo) / atr, "#.#") + " ATR", legDir == 1 ? bullC : legDir == -1 ? bearC : textC)
    row(2, "Retraced", na(retr) ? "-" : str.tostring(retr, "#.#") + "%", retr >= 61.8 and retr <= 65 ? goldC : textC)
    row(3, "Golden zone", legDir == 0 ? "-" : gzDone and (gzReactUp or gzReactDn) ? "reacted" : gzDone ? "done" : gzTouched ? "in play ●" : "waiting", goldC)
    row(4, "Pivot P (" + pivTf + ")", na(P) ? "-" : str.tostring(P, format.mintick) + (close >= P ? " • above" : " • below"), close >= P ? bullC : bearC)
    row(5, "Nearest pivot", na(nearDist) ? "-" : nearName + " • " + str.tostring(nearDist / atr, "#.#") + " ATR", accentC)

// ---------- Alerts ----------
bool crossP = ta.cross(close, P)
alertcondition(legNew, "New fib leg", "Nexus Fib: new swing leg on {{ticker}} {{interval}}")
alertcondition(gzTouchNow, "Golden zone touched", "Nexus Fib: price reached the golden zone on {{ticker}} {{interval}} at {{close}}")
alertcondition(gzReactUp, "Golden zone reaction up", "Nexus Fib: golden zone reaction up on {{ticker}} {{interval}} at {{close}}")
alertcondition(gzReactDn, "Golden zone reaction down", "Nexus Fib: golden zone reaction down on {{ticker}} {{interval}} at {{close}}")
alertcondition(crossP, "Price crossed the pivot", "Nexus Fib: price crossed the pivot P on {{ticker}} {{interval}} at {{close}}")
