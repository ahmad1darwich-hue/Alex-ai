//@version=6
indicator("Nexus Liquidity - Pools, Sweeps & Stop Hunts", shorttitle = "NX Liq", overlay = true, max_lines_count = 150, max_labels_count = 120)

// Where the stops sit: buy-side liquidity (BSL) above swing highs and sell-side liquidity (SSL) below swing lows, stronger
// where several swings line up (equal highs / lows) and at the previous day / week high and low. A pool ends in one of
// two ways: SWEPT (a wick takes the stops and the bar closes back - a stop hunt) or TAKEN (a close beyond it - the move
// runs). After a sweep, a close back past the sweep candle is the HUNT signal. Confirmed bars only.

// ---------- Inputs ----------
string GRP_P = "Pools"
bool   autoInput     = input.bool(true, "Auto swing length", group = GRP_P, tooltip = "5m and below: 4, intraday: 6, 4h and above: 8. Turn off to use the manual value.")
int    lenInput      = input.int(6, "Swing length (manual)", minval = 2, maxval = 50, group = GRP_P)
float  eqTolInput    = input.float(0.15, "Equal tolerance (x ATR)", minval = 0.02, step = 0.01, group = GRP_P, tooltip = "Swings closer than this join one pool (equal highs / lows).")
int    minHitsInput  = input.int(1, "Min swings per pool", minval = 1, maxval = 4, group = GRP_P, tooltip = "1 shows every swing as liquidity (single swings faint); 2 shows equal highs / lows only.")
int    perSideInput  = input.int(6, "Pools per side", minval = 1, maxval = 15, group = GRP_P)
bool   showHtfInput  = input.bool(true, "Previous day / week high & low", group = GRP_P)
string GRP_H = "Stop hunts"
bool   showHuntInput = input.bool(true, "HUNT signals", group = GRP_H, tooltip = "After a sweep, a close back beyond the sweep candle within the window below.")
int    huntWinInput  = input.int(3, "Confirm within (bars)", minval = 1, maxval = 10, group = GRP_H)
string GRP_L = "Layers"
bool   showDashInput = input.bool(true, "Dashboard", group = GRP_L)
string GRP_S = "Style"
string themeInput = input.string("Neon", "Theme", options = ["Neon", "Classic", "Minimal", "Mono"], group = GRP_S)

// ---------- Theme ----------
pick(color neon, color classic, color minimal, color mono) =>
    themeInput == "Neon" ? neon : themeInput == "Classic" ? classic : themeInput == "Minimal" ? minimal : mono

color bullC    = pick(#00E5A0, #089981, #26A69A, #D1D4DC)
color bearC    = pick(#FF3D71, #F23645, #EF5350, #787B86)
color liqC     = pick(#FFC400, #B8860B, #C9A227, #B2B5BE)
color accentC  = pick(#7C4DFF, #2962FF, #B2B5BE, #E0E3EB)
color neutralC = pick(#8C8FA3, #787B86, #9598A1, #5D606B)
color textC    = pick(#9598A1, #787B86, #9598A1, #B2B5BE)

// ---------- Types & state ----------
type Pool
    line   ln
    label  lb
    float  price
    int    side   // 1 = buy-side (above highs), -1 = sell-side (below lows)
    int    hits
    string kind   // "Swing", "EQ", "PDH", "PDL", "PWH", "PWL"
    int    born

type Hunt
    int   dir     // 1 = after a sell-side sweep (look for up), -1 = after a buy-side sweep
    float trigger // close beyond this confirms
    float stop
    int   bar

var array<Pool> pools = array.new<Pool>()
var array<Hunt> hunts = array.new<Hunt>()
var array<line> ended = array.new<line>() // finished pools stay as faint history, newest 30
var int    sweptB = 0
var int    sweptS = 0
var string lastEvent = "-"
var int    lastEventBar = na

int   tfSec = timeframe.in_seconds()
int   len   = autoInput ? (tfSec <= 300 ? 4 : tfSec < 14400 ? 6 : 8) : lenInput
float atr   = ta.atr(14)
float ph    = ta.pivothigh(high, len, len)
float pl    = ta.pivotlow(low, len, len)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ---------- Pool helpers ----------
tagText(Pool p) =>
    string name = p.kind == "Swing" or p.kind == "EQ" ? (p.side == 1 ? "BSL" : "SSL") : p.kind
    name + (p.hits > 1 ? " x" + str.tostring(p.hits) : "") + " " + str.tostring(p.price, format.mintick)

restyle(Pool p) =>
    bool  strong = p.hits > 1 or p.kind != "Swing"
    color c = p.kind == "Swing" or p.kind == "EQ" ? (p.side == 1 ? bearC : bullC) : liqC
    p.ln.set_color(color.new(c, strong ? 15 : 55))
    p.ln.set_width(strong ? 2 : 1)
    p.ln.set_style(strong ? line.style_solid : line.style_dashed)
    p.lb.set_textcolor(color.new(c, strong ? 0 : 35))
    p.lb.set_text(tagText(p))

newPool(float price, int side, int x, string kind) =>
    Pool p = Pool.new(line.new(x, price, bar_index + 8, price), label.new(bar_index + 8, price, "", style = label.style_label_left, color = color.new(color.black, 100), size = size.tiny), price, side, 1, kind, bar_index)
    restyle(p)
    pools.push(p)
    int same = 0
    for k = pools.size() - 1 to 0
        Pool q = pools.get(k)
        if q.side == side and q.kind != "PDH" and q.kind != "PDL" and q.kind != "PWH" and q.kind != "PWL"
            same += 1
            if same > perSideInput
                q.ln.delete()
                q.lb.delete()
                pools.remove(k)
    true

// A new swing joins a live pool on its side within the tolerance (equal highs / lows) or starts one.
addSwing(float price, int side, int x) =>
    bool joined = false
    for p in pools
        if not joined and p.side == side and (p.kind == "Swing" or p.kind == "EQ") and math.abs(p.price - price) <= eqTolInput * atr
            p.hits  += 1
            p.kind  := "EQ"
            p.price := side == 1 ? math.max(p.price, price) : math.min(p.price, price)
            p.ln.set_y1(p.price)
            p.ln.set_y2(p.price)
            p.lb.set_y(p.price)
            restyle(p)
            joined := true
    if not joined
        newPool(price, side, x, "Swing")
    joined

// A previous day / week level that sits on a live swing pool upgrades that pool instead of drawing a second line.
addHtf(float price, int side, string kind) =>
    bool merged = false
    for p in pools
        if not merged and p.side == side and math.abs(p.price - price) <= eqTolInput * atr
            p.hits  += 1
            p.kind  := kind
            p.price := price
            p.ln.set_y1(price)
            p.ln.set_y2(price)
            p.lb.set_y(price)
            restyle(p)
            merged := true
    if not merged
        newPool(price, side, bar_index, kind)
    merged

// ---------- New pools ----------
if not na(atr)
    if not na(ph)
        addSwing(ph, 1, bar_index - len)
    if not na(pl)
        addSwing(pl, -1, bar_index - len)
    if showHtfInput and tfSec < 86400
        if not na(pdh) and pdh != pdh[1]
            addHtf(pdh, 1, "PDH")
            addHtf(pdl, -1, "PDL")
        if not na(pwh) and pwh != pwh[1] and tfSec < 14400
            addHtf(pwh, 1, "PWH")
            addHtf(pwl, -1, "PWL")

// ---------- Life cycle on confirmed bars: swept (stop hunt) or taken (run) ----------
bool sweepB = false
bool sweepS = false
bool takenB = false
bool takenS = false
if barstate.isconfirmed and pools.size() > 0
    for k = pools.size() - 1 to 0
        Pool p = pools.get(k)
        bool show = p.hits >= minHitsInput or p.kind != "Swing"
        bool hit  = bar_index > p.born and (p.side == 1 ? high > p.price : low < p.price)
        if hit
            bool swept = p.side == 1 ? close < p.price : close > p.price
            color c = p.side == 1 ? bearC : bullC
            p.ln.set_x2(bar_index)
            p.ln.set_style(line.style_dotted)
            p.ln.set_color(color.new(c, swept ? 30 : 70))
            p.lb.delete()
            if swept and show
                if p.side == 1
                    sweepB := true
                    sweptB += 1
                else
                    sweepS := true
                    sweptS += 1
                label.new(bar_index, p.side == 1 ? high : low, "✕ SWEEP", style = p.side == 1 ? label.style_label_down : label.style_label_up, color = color.new(liqC, 100), textcolor = liqC, size = size.tiny, tooltip = (p.side == 1 ? "Buy-side" : "Sell-side") + " liquidity swept at " + str.tostring(p.price, format.mintick) + " (" + p.kind + (p.hits > 1 ? " x" + str.tostring(p.hits) : "") + "): wick through, close back.")
                hunts.push(Hunt.new(-p.side, p.side == 1 ? low : high, p.side == 1 ? high + atr * 0.2 : low - atr * 0.2, bar_index))
                lastEvent := (p.side == 1 ? "BSL" : "SSL") + " swept"
                lastEventBar := bar_index
            else if show
                takenB := takenB or p.side == 1
                takenS := takenS or p.side == -1
                lastEvent := (p.side == 1 ? "BSL" : "SSL") + " taken"
                lastEventBar := bar_index
            if not show
                p.ln.delete()
            else
                ended.push(p.ln)
                if ended.size() > 30
                    ended.shift().delete()
            pools.remove(k)
        else
            p.ln.set_x2(bar_index + 8)
            p.lb.set_x(bar_index + 8)
            if not show
                p.ln.set_color(color.new(neutralC, 100))
                p.lb.set_textcolor(color.new(neutralC, 100))

// ---------- HUNT: the reversal after a sweep ----------
bool huntUp = false
bool huntDn = false
if barstate.isconfirmed and hunts.size() > 0
    for k = hunts.size() - 1 to 0
        Hunt h = hunts.get(k)
        if bar_index > h.bar and (h.dir == 1 ? close > h.trigger : close < h.trigger)
            if showHuntInput
                label.new(bar_index, h.dir == 1 ? low - atr * 0.4 : high + atr * 0.4, h.dir == 1 ? "▲ HUNT" : "▼ HUNT", style = h.dir == 1 ? label.style_label_up : label.style_label_down, color = h.dir == 1 ? bullC : bearC, textcolor = color.white, size = size.small, tooltip = "Stops were taken, then price closed back beyond the sweep candle. Invalid beyond " + str.tostring(h.stop, format.mintick) + ".")
            huntUp := huntUp or h.dir == 1
            huntDn := huntDn or h.dir == -1
            hunts.remove(k)
        else if bar_index - h.bar >= huntWinInput
            hunts.remove(k)

// ---------- Dashboard ----------
var table dash = table.new(position.top_right, 2, 6, border_width = 1, border_color = color.new(#787B86, 85), frame_color = color.new(liqC, 40), frame_width = 1)
row(int r, string k, string v, color vc) =>
    dash.cell(0, r, k, text_color = textC, bgcolor = color.new(#131722, 10), text_size = size.small, text_halign = text.align_left)
    dash.cell(1, r, v, text_color = vc, bgcolor = color.new(#131722, 10), text_size = size.small, text_halign = text.align_right, text_font_family = font.family_monospace)

if showDashInput and barstate.islast
    float nb = na
    float ns = na
    int cb = 0
    int cs = 0
    for p in pools
        if p.hits >= minHitsInput or p.kind != "Swing"
            if p.side == 1 and p.price > close
                cb += 1
                nb := na(nb) ? p.price : math.min(nb, p.price)
            if p.side == -1 and p.price < close
                cs += 1
                ns := na(ns) ? p.price : math.max(ns, p.price)
    dash.cell(0, 0, "NEXUS", text_color = color.white, bgcolor = color.new(liqC, 25), text_size = size.small)
    dash.cell(1, 0, "Liquidity", text_color = color.white, bgcolor = color.new(liqC, 25), text_size = size.small)
    row(1, "Buy-side ▲", na(nb) ? "-" : str.tostring(nb, format.mintick) + " • " + str.tostring((nb - close) / atr, "#.#") + " ATR", bearC)
    row(2, "Sell-side ▼", na(ns) ? "-" : str.tostring(ns, format.mintick) + " • " + str.tostring((close - ns) / atr, "#.#") + " ATR", bullC)
    row(3, "Resting pools", str.tostring(cb) + " BSL / " + str.tostring(cs) + " SSL", textC)
    row(4, "Sweeps", str.tostring(sweptB) + " BSL / " + str.tostring(sweptS) + " SSL", liqC)
    row(5, "Last event", na(lastEventBar) ? "-" : lastEvent + " • " + str.tostring(bar_index - lastEventBar) + " bars", accentC)

// ---------- Alerts ----------
alertcondition(sweepB, "Buy-side liquidity swept", "Nexus Liquidity: buy-side liquidity swept on {{ticker}} {{interval}} at {{close}}")
alertcondition(sweepS, "Sell-side liquidity swept", "Nexus Liquidity: sell-side liquidity swept on {{ticker}} {{interval}} at {{close}}")
alertcondition(huntUp, "HUNT up", "Nexus Liquidity: stop hunt reversal up on {{ticker}} {{interval}} at {{close}}")
alertcondition(huntDn, "HUNT down", "Nexus Liquidity: stop hunt reversal down on {{ticker}} {{interval}} at {{close}}")
alertcondition(takenB or takenS, "Liquidity taken", "Nexus Liquidity: a liquidity pool was taken (close beyond) on {{ticker}} {{interval}}")
