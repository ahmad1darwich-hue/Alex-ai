//@version=6
indicator("Nexus S/R - Strength Zones & Role Flips", shorttitle = "NX S/R", overlay = true, max_boxes_count = 200, max_labels_count = 200, max_lines_count = 100)

// ---------- Inputs ----------
string GRP_D = "Zone engine"
bool   autoInput      = input.bool(true, "Auto settings", group = GRP_D, tooltip = "Picks the pivot length from the chart timeframe: 5m and below 5, intraday 8, 4h and above 10. Turn off to use the manual value below.")
int    pivotLenInput  = input.int(8, "Pivot length (manual)", minval = 2, maxval = 50, group = GRP_D, tooltip = "Bars on each side of a swing. A level is confirmed this many bars late - it never repaints after that.")
float  minWInput      = input.float(0.15, "Zone height min (x ATR)", minval = 0.02, step = 0.05, group = GRP_D, inline = "w")
float  maxWInput      = input.float(0.80, "max", minval = 0.1, step = 0.05, group = GRP_D, inline = "w", tooltip = "Zones are built from the swing's wick to its body, then kept between these heights so they stay tradable.")
int    maxZonesInput  = input.int(8, "Maximum live zones", minval = 2, maxval = 20, group = GRP_D, tooltip = "When there are more, the weakest zone (lowest strength score) is dropped.")
int    minTouchInput  = input.int(1, "Show zones with at least this many touches", minval = 1, maxval = 10, group = GRP_D)
string breakInput     = input.string("Full body", "A zone breaks on", options = ["Full body", "Close"], group = GRP_D, tooltip = "Full body: the whole candle body closes beyond the zone (wick probes and half-closes do not count). Close: any close beyond it.")
int    decayInput     = input.int(150, "Freshness decay (bars)", minval = 10, group = GRP_D, tooltip = "A zone that is not visited for this many bars loses its freshness points.")
bool   useHtfInput    = input.bool(true, "Higher-timeframe confluence", group = GRP_D, inline = "htf")
string htfInput       = input.timeframe("240", "", group = GRP_D, inline = "htf", tooltip = "A zone that contains the last confirmed swing of this timeframe scores higher and is tagged HTF. Uses closed HTF bars only.")

string GRP_L = "Layers"
string modeInput      = input.string("Present", "Mode", options = ["Present", "Historical"], group = GRP_L, tooltip = "Present keeps only live zones. Historical also keeps the last broken zones, faded, where they broke.")
bool   showFlipInput  = input.bool(true, "Role flips (broken zones change side)", group = GRP_L, tooltip = "Only zones with 2+ touches flip: a level without history is simply removed when it breaks. A flipped zone broken back is a failed flip and is removed.")
bool   showRetestInput = input.bool(true, "Retest signals on flipped zones", group = GRP_L)
bool   showMidInput   = input.bool(false, "Zone mid line", group = GRP_L)
bool   showDashInput  = input.bool(true, "Dashboard", group = GRP_L)
string dashPosInput   = input.string("Top right", "Dashboard position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = GRP_L)

string GRP_R = "Track record"
float  targetRInput   = input.float(1.0, "Retest hit = reaches this many R", minval = 0.5, step = 0.25, group = GRP_R, tooltip = "Stop = 0.5 ATR beyond the far side of the zone. A retest counts as a hit when price reaches entry + this many times the risk before the stop.")
int    expiryInput    = input.int(40, "Give up after (bars)", minval = 5, group = GRP_R)

string GRP_ST = "Style"
string themeInput = input.string("Neon", "Theme", options = ["Neon", "Classic", "Minimal", "Mono"], group = GRP_ST)

// ---------- Theme ----------
pick(color neon, color classic, color minimal, color mono) =>
    themeInput == "Neon" ? neon : themeInput == "Classic" ? classic : themeInput == "Minimal" ? minimal : mono

color supC     = pick(#00E5A0, #089981, #26A69A, #D1D4DC)
color resC     = pick(#FF3D71, #F23645, #EF5350, #787B86)
color accentC  = pick(#7C4DFF, #2962FF, #B2B5BE, #E0E3EB)
color neutralC = pick(#8C8FA3, #787B86, #9598A1, #5D606B)
color textC    = pick(#9598A1, #787B86, #9598A1, #B2B5BE)

// ---------- Types & state ----------
type SRZone
    float top
    float bot
    int   left
    int   touches
    int   lastTouchBar
    int   side          // 1 = support (price above), -1 = resistance (price below), 0 = price inside since birth
    bool  flipped       // broken once and now playing the other role
    bool  retested      // the flipped zone already gave its retest signal
    bool  inside
    bool  htf
    box   bx
    line  mid

type Pending
    int   dir
    float entry
    float stop
    int   bar

var array<SRZone> zones   = array.new<SRZone>()
var array<box>    history = array.new<box>()
var array<Pending> pending = array.new<Pending>()
var int hits = 0
var int fails = 0
var int flips = 0
var int failedFlips = 0

int   tfSec    = timeframe.in_seconds()
int   pivotLen = autoInput ? (tfSec <= 300 ? 5 : tfSec < 14400 ? 8 : 10) : pivotLenInput
float atr      = ta.atr(14)
float ph       = ta.pivothigh(high, pivotLen, pivotLen)
float pl       = ta.pivotlow(low, pivotLen, pivotLen)
float bodyHi   = math.max(open[pivotLen], close[pivotLen])
float bodyLo   = math.min(open[pivotLen], close[pivotLen])

// Last confirmed swing high / low of the higher timeframe (closed HTF bars only: offset 1 + lookahead on).
[htfHi, htfLo] = request.security(syminfo.tickerid, htfInput, [ta.valuewhen(not na(ta.pivothigh(high, 3, 3)), high[3], 0)[1], ta.valuewhen(not na(ta.pivotlow(low, 3, 3)), low[3], 0)[1]], lookahead = barmerge.lookahead_on)

// ---------- Functions ----------
// Strength 0-100: touches (independent visits) 45, freshness 35 (decays with bars since the last visit), HTF confluence 20.
score(SRZone z) =>
    float t = math.min(z.touches, 5) / 5.0 * 45.0
    float f = 35.0 * math.max(0.0, 1.0 - (bar_index - z.lastTouchBar) / float(decayInput))
    math.round(t + f + (z.htf ? 20.0 : 0.0))

hasHtf(float top, float bot) =>
    useHtfInput and ((not na(htfHi) and htfHi <= top + atr * 0.1 and htfHi >= bot - atr * 0.1) or (not na(htfLo) and htfLo <= top + atr * 0.1 and htfLo >= bot - atr * 0.1))

// A confirmed pivot joins an overlapping zone (one more touch if it is a separate visit) or starts a new zone.
// Zone = wick extreme to body edge of the swing candle, clamped between min and max height in ATR.
addPivot(bool isHigh, float p, float body) =>
    float hMin  = math.max(atr * minWInput, syminfo.mintick * 4)
    float hMax  = atr * maxWInput
    float h     = math.min(math.max(math.abs(p - body), hMin), hMax)
    float top   = isHigh ? p : p + h
    float bot   = isHigh ? p - h : p
    int   at    = bar_index - pivotLen
    bool merged = false
    if zones.size() > 0
        for z in zones
            if not merged and top >= z.bot - atr * 0.1 and bot <= z.top + atr * 0.1
                merged := true
                if at - z.lastTouchBar >= pivotLen
                    z.touches += 1
                z.lastTouchBar := at
                // Grow toward the new swing but never beyond the max height.
                float nt = math.max(z.top, top)
                float nb = math.min(z.bot, bot)
                if nt - nb <= hMax
                    z.top := nt
                    z.bot := nb
                z.htf := z.htf or hasHtf(z.top, z.bot)
    if not merged
        box b = box.new(at, top, bar_index + 20, bot, border_color = color.new(neutralC, 50), bgcolor = color.new(neutralC, 88), border_width = 1, text_size = size.tiny, text_halign = text.align_right, text_color = textC)
        line m = showMidInput ? line.new(at, (top + bot) / 2, bar_index + 20, (top + bot) / 2, color = color.new(neutralC, 50), style = line.style_dotted) : na
        zones.push(SRZone.new(top, bot, at, 1, at, 0, false, false, false, hasHtf(top, bot), b, m))
        if zones.size() > maxZonesInput
            int worst = 0
            for i = 1 to zones.size() - 2
                if score(zones.get(i)) < score(zones.get(worst))
                    worst := i
            SRZone gone = zones.remove(worst)
            gone.bx.delete()
            gone.mid.delete()

// Ends a zone: deleted in Present mode, kept faded where it broke in Historical mode.
retire(SRZone z) =>
    z.mid.delete()
    if modeInput == "Historical"
        z.bx.set_right(bar_index)
        z.bx.set_bgcolor(color.new(neutralC, 94))
        z.bx.set_border_color(color.new(neutralC, 75))
        z.bx.set_border_style(line.style_dotted)
        z.bx.set_text("")
        history.push(z.bx)
        if history.size() > 20
            history.shift().delete()
    else
        z.bx.delete()

// ---------- Engine (confirmed bars only) ----------
bool supportTest = false
bool resistTest  = false
bool breakUp     = false
bool breakDown   = false
bool retestBull  = false
bool retestBear  = false

if barstate.isconfirmed and not na(atr)
    if not na(ph)
        addPivot(true, ph, bodyHi)
    if not na(pl)
        addPivot(false, pl, bodyLo)

    if zones.size() > 0
        for i = zones.size() - 1 to 0
            SRZone z = zones.get(i)
            float upRef = breakInput == "Full body" ? math.min(open, close) : close
            float dnRef = breakInput == "Full body" ? math.max(open, close) : close
            int   pos   = upRef > z.top ? 1 : dnRef < z.bot ? -1 : 0
            bool  touching = high >= z.bot and low <= z.top
            bool  remove = false
            if z.side == 0 and pos != 0
                z.side := pos
            else if pos != 0 and pos != z.side
                // Decisive break to the other side.
                breakUp   := breakUp or pos == 1
                breakDown := breakDown or pos == -1
                if z.flipped or not showFlipInput or z.touches < 2
                    // Second break = failed flip; a level without history (one touch) does not flip at all.
                    failedFlips += z.flipped ? 1 : 0
                    remove := true
                else
                    z.flipped  := true
                    z.retested := false
                    z.side     := pos
                    z.lastTouchBar := bar_index
                    flips += 1
            else if touching and not z.inside and z.side != 0 and pos != -z.side
                // A visit from the zone's own side.
                bool closedOut = z.side == 1 ? close > z.top : close < z.bot
                supportTest := supportTest or z.side == 1
                resistTest  := resistTest or z.side == -1
                if bar_index - z.lastTouchBar >= pivotLen
                    z.touches += 1
                z.lastTouchBar := bar_index
                // First return to a flipped zone that is rejected in the breakout direction = retest signal.
                if z.flipped and not z.retested and closedOut
                    z.retested := true
                    float stop = z.side == 1 ? z.bot - atr * 0.5 : z.top + atr * 0.5
                    pending.push(Pending.new(z.side, close, stop, bar_index))
                    retestBull := retestBull or z.side == 1
                    retestBear := retestBear or z.side == -1
                    if showRetestInput
                        label.new(bar_index, z.side == 1 ? low - atr * 0.3 : high + atr * 0.3, z.side == 1 ? "▲ RETEST" : "▼ RETEST", style = z.side == 1 ? label.style_label_up : label.style_label_down, color = z.side == 1 ? supC : resC, textcolor = color.white, size = size.small, tooltip = "Entry " + str.tostring(close, format.mintick) + " • stop " + str.tostring(stop, format.mintick))
            z.inside := touching
            if remove
                retire(z)
                zones.remove(i)

// Track record of retest signals (target first = hit, stop first = fail, or expired).
if barstate.isconfirmed and pending.size() > 0
    for i = pending.size() - 1 to 0
        Pending p = pending.get(i)
        if bar_index > p.bar
            float risk = math.abs(p.entry - p.stop)
            float tgt  = p.entry + p.dir * risk * targetRInput
            bool  won  = p.dir == 1 ? high >= tgt : low <= tgt
            bool  lost = p.dir == 1 ? low <= p.stop : high >= p.stop
            if won and not lost
                hits += 1
                pending.remove(i)
            else if lost
                fails += 1
                pending.remove(i)
            else if bar_index - p.bar >= expiryInput
                pending.remove(i)

// ---------- Drawing (last bar: zones run to the right edge, strength sets the fill) ----------
float nearRes = na
float nearSup = na
int   nSup = 0
int   nRes = 0
int   bestScore = -1
float bestMid = na
if barstate.islast and zones.size() > 0
    for z in zones
        int   sc   = score(z)
        bool  vis  = z.touches >= minTouchInput
        int   side = z.side != 0 ? z.side : close >= (z.top + z.bot) / 2 ? 1 : -1
        color c    = side == 1 ? supC : resC
        color fillC = color.from_gradient(sc, 20, 90, color.new(c, 92), color.new(c, 74))
        z.bx.set_top(z.top)
        z.bx.set_bottom(z.bot)
        z.bx.set_right(bar_index + 20)
        z.bx.set_bgcolor(vis ? fillC : na)
        z.bx.set_border_color(vis ? color.new(c, z.flipped ? 40 : 55) : na)
        z.bx.set_border_style(z.flipped ? line.style_dashed : line.style_solid)
        z.bx.set_text_color(color.new(c, 10))
        z.bx.set_text(vis ? (side == 1 ? "S" : "R") + (z.flipped ? " flip" : "") + (z.htf ? " • HTF" : "") + " • x" + str.tostring(z.touches) + " • " + str.tostring(sc) : "")
        if not na(z.mid)
            z.mid.set_xy1(z.left, (z.top + z.bot) / 2)
            z.mid.set_xy2(bar_index + 20, (z.top + z.bot) / 2)
            z.mid.set_color(color.new(c, 40))
        if vis
            if side == 1
                nSup += 1
                if close >= z.bot and (na(nearSup) or z.top > nearSup)
                    nearSup := z.top
            else
                nRes += 1
                if close <= z.top and (na(nearRes) or z.bot < nearRes)
                    nearRes := z.bot
            if sc > bestScore
                bestScore := sc
                bestMid := (z.top + z.bot) / 2

// ---------- Dashboard ----------
dashPos = dashPosInput == "Top right" ? position.top_right : dashPosInput == "Bottom right" ? position.bottom_right : dashPosInput == "Top left" ? position.top_left : position.bottom_left
var table dash = table.new(dashPos, 2, 7, border_width = 1, border_color = color.new(#787B86, 85), frame_color = color.new(accentC, 40), frame_width = 1)

row(int r, string k, string v, color vc) =>
    dash.cell(0, r, k, text_color = textC, bgcolor = color.new(#131722, 10), text_size = size.small, text_halign = text.align_left)
    dash.cell(1, r, v, text_color = vc, bgcolor = color.new(#131722, 10), text_size = size.small, text_halign = text.align_right, text_font_family = font.family_monospace)

distText(float lvl) =>
    na(lvl) ? "-" : str.tostring(lvl, format.mintick) + " • " + str.tostring(math.abs(close - lvl) / atr, "#.#") + " ATR"

if showDashInput and barstate.islast
    int judged = hits + fails
    dash.cell(0, 0, "NEXUS", text_color = color.white, bgcolor = color.new(accentC, 15), text_size = size.small)
    dash.cell(1, 0, "S/R zones", text_color = color.white, bgcolor = color.new(accentC, 15), text_size = size.small)
    row(1, "Resistance ▲", distText(nearRes), resC)
    row(2, "Support ▼", distText(nearSup), supC)
    row(3, "Live zones", str.tostring(nSup) + " S / " + str.tostring(nRes) + " R", textC)
    row(4, "Strongest", bestScore < 0 ? "-" : str.tostring(bestMid, format.mintick) + " • " + str.tostring(bestScore), accentC)
    row(5, "Flips / failed", str.tostring(flips) + " / " + str.tostring(failedFlips), textC)
    row(6, "Retest hits", str.tostring(hits) + " / " + str.tostring(judged) + (judged > 0 ? " • " + str.tostring(hits * 100.0 / judged, "#") + "%" : ""), judged > 0 ? color.from_gradient(hits * 100.0 / judged, 35, 65, resC, supC) : textC)

// ---------- Alerts ----------
alertcondition(supportTest, "Support tested", "Nexus S/R: support tested on {{ticker}} {{interval}} at {{close}}")
alertcondition(resistTest, "Resistance tested", "Nexus S/R: resistance tested on {{ticker}} {{interval}} at {{close}}")
alertcondition(breakUp, "Zone broken upward", "Nexus S/R: zone broken upward on {{ticker}} {{interval}} at {{close}}")
alertcondition(breakDown, "Zone broken downward", "Nexus S/R: zone broken downward on {{ticker}} {{interval}} at {{close}}")
alertcondition(retestBull, "Bullish retest", "Nexus S/R: broken resistance retested as support on {{ticker}} {{interval}} at {{close}}")
alertcondition(retestBear, "Bearish retest", "Nexus S/R: broken support retested as resistance on {{ticker}} {{interval}} at {{close}}")
