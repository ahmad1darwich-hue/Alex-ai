{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/areas/bondi",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/areas/bondi-junction",
      "destination": "/areas/eastern-suburbs",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/contact/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/services",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/areas",
      "destination": "/areas/index.html"
    },
    {
      "source": "/areas/:slug",
      "destination": "/areas/:slug.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/services/:slug.html"
    },
    {
      "source": "/((?!api|gallery|areas|services|assets|sitemap|robots|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}