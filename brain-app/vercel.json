{
  "cleanUrls": true,
  "functions": {
    "api/agent.js": { "maxDuration": 60 },
    "api/whatsapp.js": { "maxDuration": 60 },
    "api/wa-customer.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
