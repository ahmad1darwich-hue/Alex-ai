//@version=6
indicator("Nexus Support & Resistance Zones", shorttitle = "Nexus S/R", overlay = true, max_boxes_count = 200, max_labels_count = 200)

// ───────────── Inputs ─────────────
string GRP_D = "Detection"
int    pivotLenInput  = input.int(10, "Pivot length", minval = 2, maxval = 50, group = GRP_D, tooltip = "Bars on each side of a swing. Bigger = fewer, stronger levels.")
float  widthInput     = input.float(0.35, "Zone half-height (x ATR)", minval = 0.05, step = 0.05, group = GRP_D)
int    maxZonesInput  = input.int(6, "Maximum zones", minval = 2, maxval = 20, group = GRP_D)
int    minTouchInput  = input.int(1, "Show zones with at least this many touches", minval = 1, maxval = 10, group = GRP_D)
string breakSrcInput  = input.string("Close", "A zone breaks on", options = ["Close", "Wick"], group = GRP_D)

string GRP_V = "Visuals"
color  supColorInput  = input.color(#089981, "Support", group = GRP_V, inline = "c")
color  resColorInput  = input.color(#F23645, "Resistance", group = GRP_V, inline = "c")
color  midColorInput  = input.color(#787B86, "Price inside", group = GRP_V, inline = "c")
bool   showLabelInput = input.bool(true, "Show touch count", group = GRP_V)

// ───────────── Types & state ─────────────
type SRZone
    float price
    float half
    int   touches
    int   lastTouchBar
    int   side         // 1 = price above (support), -1 = price below (resistance), 0 = unknown yet
    int   breaks
    bool  inside
    box   bx
    label lb

var array<SRZone> zones = array.new<SRZone>()
float atr = ta.atr(14)
float ph = ta.pivothigh(high, pivotLenInput, pivotLenInput)
float pl = ta.pivotlow(low, pivotLenInput, pivotLenInput)

// Merges a confirmed pivot into a nearby zone, or starts a new zone.
addPivot(float p) =>
    bool merged = false
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            SRZone z = zones.get(i)
            if not merged and math.abs(p - z.price) <= z.half * 2
                z.touches += 1
                z.price := (z.price * (z.touches - 1) + p) / z.touches
                z.lastTouchBar := bar_index - pivotLenInput
                merged := true
    if not merged
        float half = math.max(atr * widthInput, syminfo.mintick * 2)
        box b = box.new(bar_index - pivotLenInput, p + half, bar_index, p - half, border_color = color.new(midColorInput, 60), bgcolor = color.new(midColorInput, 85))
        label l = label.new(bar_index, p, "", style = label.style_label_left, color = color.new(midColorInput, 100), textcolor = midColorInput, size = size.tiny)
        zones.push(SRZone.new(p, half, 1, bar_index - pivotLenInput, 0, 0, false, b, l))
        // Over the cap: drop the weakest zone (fewest touches, then the one touched longest ago).
        if zones.size() > maxZonesInput
            int worst = 0
            for i = 1 to zones.size() - 1
                SRZone a = zones.get(i)
                SRZone w = zones.get(worst)
                if a.touches < w.touches or (a.touches == w.touches and a.lastTouchBar < w.lastTouchBar)
                    worst := i
            // Never drop the zone that was just created.
            if worst == zones.size() - 1
                worst := 0
            SRZone gone = zones.remove(worst)
            gone.bx.delete()
            gone.lb.delete()

bool supportTest = false
bool resistTest  = false
bool breakUp     = false
bool breakDown   = false

if barstate.isconfirmed
    if not na(ph) and not na(atr)
        addPivot(ph)
    if not na(pl) and not na(atr)
        addPivot(pl)

    if zones.size() > 0
        for i = zones.size() - 1 to 0
            SRZone z = zones.get(i)
            float top = z.price + z.half
            float bot = z.price - z.half
            float upRef = breakSrcInput == "Close" ? close : high
            float dnRef = breakSrcInput == "Close" ? close : low
            int newSide = dnRef > top ? 1 : upRef < bot ? -1 : 0
            // A break is a move from one side of the zone to the other.
            if newSide != 0 and z.side != 0 and newSide != z.side
                z.breaks += 1
                breakUp   := breakUp or newSide == 1
                breakDown := breakDown or newSide == -1
            if newSide != 0
                z.side := newSide
            // A test is the first bar that trades into the zone from outside and closes back out.
            bool touching = high >= bot and low <= top
            if touching and not z.inside and newSide == z.side and z.side != 0
                supportTest := supportTest or z.side == 1
                resistTest  := resistTest or z.side == -1
            z.inside := touching

            if z.breaks >= 2
                // Broken in both directions: the level no longer holds.
                z.bx.delete()
                z.lb.delete()
                zones.remove(i)
            else
                bool visible = z.touches >= minTouchInput
                color c = newSide == 0 ? midColorInput : z.side == 1 ? supColorInput : resColorInput
                z.bx.set_top(top)
                z.bx.set_bottom(bot)
                z.bx.set_right(bar_index)
                z.bx.set_bgcolor(visible ? color.new(c, 85) : na)
                z.bx.set_border_color(visible ? color.new(c, 55) : na)
                z.lb.set_xy(bar_index + 1, z.price)
                z.lb.set_text(visible and showLabelInput ? (z.side == 1 ? "S" : z.side == -1 ? "R" : "") + " x" + str.tostring(z.touches) : "")
                z.lb.set_textcolor(c)

// ───────────── Alerts ─────────────
alertcondition(supportTest, "Support tested",    "Nexus S/R: support tested on {{ticker}} {{interval}} at {{close}}")
alertcondition(resistTest,  "Resistance tested", "Nexus S/R: resistance tested on {{ticker}} {{interval}} at {{close}}")
alertcondition(breakUp,     "Zone broken upward",   "Nexus S/R: zone broken upward on {{ticker}} {{interval}} at {{close}}")
alertcondition(breakDown,   "Zone broken downward", "Nexus S/R: zone broken downward on {{ticker}} {{interval}} at {{close}}")
