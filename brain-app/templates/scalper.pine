//@version=6
indicator("Nexus Scalper - Momentum Entries", shorttitle = "Nexus Scalper", overlay = true, max_lines_count = 100, max_labels_count = 100)

// ───────────── Inputs ─────────────
string GRP_S = "Signal"
int    fastLenInput   = input.int(21, "Fast EMA", minval = 2, group = GRP_S)
int    slowLenInput   = input.int(50, "Slow EMA", minval = 3, group = GRP_S, tooltip = "Trend is up when the fast EMA is above the slow EMA and price is above both.")
int    rsiLenInput    = input.int(7, "RSI length", minval = 2, group = GRP_S)
float  pullbackInput  = input.float(45.0, "Pullback level (RSI)", minval = 20, maxval = 50, step = 1, group = GRP_S, tooltip = "In an uptrend RSI must first dip below this level, then cross back above 50. Mirrored for downtrends.")
int    cooldownInput  = input.int(5, "Minimum bars between signals", minval = 0, group = GRP_S)

string GRP_F = "Filters"
bool   useVolInput    = input.bool(true, "Volume above average (skipped when the symbol has no volume)", group = GRP_F)
int    volLenInput    = input.int(20, "Volume average length", minval = 2, group = GRP_F)
bool   useAtrInput    = input.bool(true, "Skip quiet markets (ATR below its average)", group = GRP_F)
bool   useSessInput   = input.bool(false, "Trade only inside session", group = GRP_F, inline = "ss")
string sessInput      = input.session("0700-1700", "", group = GRP_F, inline = "ss")
string tzInput        = input.string("Europe/London", "Session timezone", options = ["Europe/London", "America/New_York", "Asia/Tokyo", "Australia/Sydney", "Asia/Dubai", "UTC"], group = GRP_F)

string GRP_R = "Quick levels"
bool   showLevelsInput = input.bool(true, "Draw stop & target for the latest signal", group = GRP_R)
float  slAtrInput     = input.float(1.0, "Stop (x ATR)", minval = 0.1, step = 0.1, group = GRP_R)
float  tpAtrInput     = input.float(1.5, "Target (x ATR)", minval = 0.1, step = 0.1, group = GRP_R)

string GRP_V = "Visuals"
color  buyColorInput  = input.color(#089981, "Buy", group = GRP_V, inline = "c")
color  sellColorInput = input.color(#F23645, "Sell", group = GRP_V, inline = "c")
bool   showEmasInput  = input.bool(true, "Show EMAs", group = GRP_V)

// ───────────── Calculations (all series functions run on every bar) ─────────────
float fastEma = ta.ema(close, fastLenInput)
float slowEma = ta.ema(close, slowLenInput)
float rsi     = ta.rsi(close, rsiLenInput)
float atr     = ta.atr(14)
float atrAvg  = ta.sma(atr, 50)
float volAvg  = ta.sma(volume, volLenInput)
bool  rsiUp   = ta.crossover(rsi, 50)
bool  rsiDn   = ta.crossunder(rsi, 50)
int   barsSinceLow  = ta.barssince(rsi < pullbackInput)
int   barsSinceHigh = ta.barssince(rsi > 100 - pullbackInput)

bool trendUp = fastEma > slowEma and close > fastEma
bool trendDn = fastEma < slowEma and close < fastEma

// Volume is optional data: forex/CFD feeds may have none. Treat missing volume as "filter passed".
bool hasVolume = not na(volume) and volume > 0 and not na(volAvg) and volAvg > 0
bool volOk   = not useVolInput or not hasVolume or volume > volAvg
bool atrOk   = not useAtrInput or na(atrAvg) or atr >= atrAvg * 0.8
bool sessOk  = not useSessInput or not na(time(timeframe.period, sessInput, tzInput))
bool bodyOk  = math.abs(close - open) >= (high - low) * 0.5

// Pullback happened recently (within 10 bars), then momentum resumes with the trend.
bool rawBuy  = trendUp and rsiUp and not na(barsSinceLow)  and barsSinceLow  <= 10 and close > open and bodyOk and volOk and atrOk and sessOk
bool rawSell = trendDn and rsiDn and not na(barsSinceHigh) and barsSinceHigh <= 10 and close < open and bodyOk and volOk and atrOk and sessOk

var int lastSignalBar = na
var line stopLine = na
var line targetLine = na
var label stopLbl = na
var label targetLbl = na
bool buySignal  = false
bool sellSignal = false

if barstate.isconfirmed and (rawBuy or rawSell) and (na(lastSignalBar) or bar_index - lastSignalBar > cooldownInput)
    buySignal  := rawBuy
    sellSignal := rawSell and not rawBuy
    lastSignalBar := bar_index
    if showLevelsInput and not na(atr)
        int   dir    = buySignal ? 1 : -1
        float stop   = close - dir * atr * slAtrInput
        float target = close + dir * atr * tpAtrInput
        stopLine.delete()
        targetLine.delete()
        stopLbl.delete()
        targetLbl.delete()
        stopLine   := line.new(bar_index, stop, bar_index + 8, stop, color = sellColorInput, style = line.style_dashed)
        targetLine := line.new(bar_index, target, bar_index + 8, target, color = buyColorInput, style = line.style_dashed)
        stopLbl    := label.new(bar_index + 8, stop, "SL " + str.tostring(stop, format.mintick), style = label.style_label_left, color = color.new(sellColorInput, 100), textcolor = sellColorInput, size = size.tiny)
        targetLbl  := label.new(bar_index + 8, target, "TP " + str.tostring(target, format.mintick), style = label.style_label_left, color = color.new(buyColorInput, 100), textcolor = buyColorInput, size = size.tiny)

// ───────────── Visuals ─────────────
plot(showEmasInput ? fastEma : na, "Fast EMA", color = color.new(trendUp ? buyColorInput : trendDn ? sellColorInput : color.gray, 20))
plot(showEmasInput ? slowEma : na, "Slow EMA", color = color.new(color.gray, 30), linewidth = 2)
plotshape(buySignal, "Buy", shape.triangleup, location.belowbar, color = buyColorInput, text = "BUY", textcolor = buyColorInput, size = size.tiny)
plotshape(sellSignal, "Sell", shape.triangledown, location.abovebar, color = sellColorInput, text = "SELL", textcolor = sellColorInput, size = size.tiny)

// ───────────── Alerts ─────────────
alertcondition(buySignal,  "Scalp buy",  "Nexus Scalper: BUY {{ticker}} {{interval}} at {{close}}")
alertcondition(sellSignal, "Scalp sell", "Nexus Scalper: SELL {{ticker}} {{interval}} at {{close}}")
